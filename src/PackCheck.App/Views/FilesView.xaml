<UserControl x:Class="PackCheck.App.Views.FilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:PackCheck.App.Infrastructure"
             xmlns:c="clr-namespace:PackCheck.App.Controls"
             AutomationProperties.AutomationId="FilesTab">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis" />
        <l:NullToVisibility x:Key="NullVis" />
        <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </UserControl.Resources>
    <UserControl.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
        <KeyBinding Key="Delete" Command="{Binding DeleteCommand}" />
        <KeyBinding Key="C" Modifiers="Control+Shift" Command="{Binding CopySelectionCommand}" />
        <KeyBinding Key="V" Modifiers="Control+Shift" Command="{Binding PasteCommand}" />
    </UserControl.InputBindings>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="6*" MinWidth="300" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="6*" />
        </Grid.ColumnDefinitions>

        <!-- Browser -->
        <Border Style="{StaticResource Card}" Padding="12" AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">
            <DockPanel>
                <!-- breadcrumbs -->
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Button DockPanel.Dock="Left" Content="↑" Command="{Binding UpCommand}" Style="{StaticResource ToolButton}" Margin="0,0,6,0" AutomationProperties.Name="Up" />
                    <ItemsControl ItemsSource="{Binding Crumbs}" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="{Binding Name}" Style="{StaticResource GhostButton}" Padding="6,4" FontSize="12.5"
                                            Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Path}" />
                                    <TextBlock Text="/" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>

                <!-- toolbar -->
                <WrapPanel DockPanel.Dock="Top">
                    <Button Content="{l:Loc Files_Upload}" Command="{Binding UploadCommand}" Style="{StaticResource ToolButton}" />
                    <Button Content="{l:Loc Files_NewFile}" Command="{Binding NewFileCommand}" Style="{StaticResource ToolButton}" />
                    <Button Content="{l:Loc Files_NewFolder}" Command="{Binding NewFolderCommand}" Style="{StaticResource ToolButton}" />
                    <Button Content="{l:Loc Files_Rename}" Command="{Binding RenameCommand}" Style="{StaticResource ToolButton}" />
                    <Button Content="{l:Loc Console_Copy}" Command="{Binding CopySelectionCommand}" Style="{StaticResource ToolButton}" />
                    <Button Content="{l:Loc Files_CutBtn}" Command="{Binding CutSelectionCommand}" Style="{StaticResource ToolButton}" />
                    <Button Content="{l:Loc Files_Paste}" Command="{Binding PasteCommand}" Style="{StaticResource ToolButton}" IsEnabled="{Binding HasClipboard}" />
                    <Button Content="Zip" Command="{Binding ZipSelectionCommand}" Style="{StaticResource ToolButton}" />
                    <Button Content="{l:Loc Files_Unzip}" Command="{Binding UnzipCommand}" Style="{StaticResource ToolButton}" />
                    <Button Content="{l:Loc Files_Export}" Command="{Binding ExportCommand}" Style="{StaticResource ToolButton}" />
                    <Button Content="{l:Loc Files_Delete}" Command="{Binding DeleteCommand}" Style="{StaticResource ToolButton}" Foreground="{DynamicResource FailBrush}" />
                    <Button Content="{l:Loc Common_OpenFolder}" Command="{Binding OpenInExplorerCommand}" Style="{StaticResource ToolButton}" />
                </WrapPanel>

                <DockPanel DockPanel.Dock="Top" Margin="0,2,0,8">
                    <CheckBox DockPanel.Dock="Left" Content="{l:Loc Validate_Filter_All}" Command="{Binding SelectAllCommand}" VerticalAlignment="Center" Margin="2,0,10,0" />
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0"
                               Text="{Binding SelectedCount, StringFormat='{}{0} ✓'}" Visibility="{Binding SelectedCount, Converter={StaticResource NullVis}}" />
                    <TextBox Tag="{l:Loc Files_Filter}" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged, Delay=150}" Padding="8,5" ToolTip="{l:Loc Files_Filter}" AutomationProperties.Name="{l:Loc Files_Filter}" />
                </DockPanel>

                <TextBlock DockPanel.Dock="Bottom" Text="{l:Loc Files_DropHint}" Style="{StaticResource Muted}" FontSize="11.5" Margin="0,8,0,0" />

                <ListBox x:Name="List" ItemsSource="{Binding Entries}" SelectionMode="Extended" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.AutomationId="FileList">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            <EventSetter Event="MouseDoubleClick" Handler="OnOpen" />
                            <EventSetter Event="KeyDown" Handler="OnItemKey" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" CornerRadius="6" Padding="8,6" Background="Transparent">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface2Brush}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimarySoftBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Modified, StringFormat='dd.MM.yy HH:mm'}" Style="{StaticResource Muted}" FontSize="11" Width="84" TextAlignment="Right" />
                                <TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}" Style="{StaticResource Muted}" FontSize="11" Width="58" TextAlignment="Right" />
                                <Path DockPanel.Dock="Left" Width="18" Height="18" Margin="0,0,10,0" Stretch="Uniform" StrokeThickness="1.4" StrokeLineJoin="Round"
                                      Data="{Binding Kind, Converter={x:Static l:FileIcon.Geometry}}" Fill="{Binding Kind, Converter={x:Static l:FileIcon.Fill}}"
                                      Stroke="{Binding Kind, Converter={x:Static l:FileIcon.Stroke}}" ToolTip="{Binding Kind}" />
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Editor -->
        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <TextBlock Text="{l:Loc Files_EditorEmpty}" Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" MaxWidth="320"
                           Visibility="{Binding HasTabs, Converter={x:Static l:Inverse.Visibility}}" />
                <DockPanel Visibility="{Binding HasTabs, Converter={StaticResource BoolVis}}">
                    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="{l:Loc Common_Save}" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" Margin="8,6" Padding="12,5"
                                    AutomationProperties.AutomationId="EditorSave" />
                            <ListBox ItemsSource="{Binding Tabs}" SelectedItem="{Binding ActiveTab}" Background="Transparent" BorderThickness="0"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Bd" Padding="12,8,6,8" BorderThickness="0,0,0,2" BorderBrush="Transparent" Cursor="Hand">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="7" Height="7" Fill="{DynamicResource WarnBrush}" Margin="0,0,6,0" VerticalAlignment="Center" Visibility="{Binding IsDirty, Converter={StaticResource BoolVis}}" />
                                            <TextBlock Text="{Binding Name}" FontSize="12.5" VerticalAlignment="Center" />
                                            <Button Content="×" Style="{StaticResource GhostButton}" Padding="6,0" Margin="4,0,0,0" FontSize="14"
                                                    Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                    <Border DockPanel.Dock="Bottom" Padding="12,6" Background="{DynamicResource Surface2Brush}" Visibility="{Binding ActiveTab.Error, Converter={StaticResource NullVis}}">
                        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource FailBrush}">
                            <Run Text="{l:Loc Files_SyntaxError}" FontWeight="SemiBold" /><Run Text=" · " /><Run Text="{Binding ActiveTab.ErrorLine, Mode=OneWay, StringFormat='#{0}'}" /><Run Text=" · " /><Run Text="{Binding ActiveTab.Error, Mode=OneWay}" />
                        </TextBlock>
                    </Border>
                    <c:CodeEditor BoundDocument="{Binding ActiveTab.Document}" FileExtension="{Binding ActiveTab.Extension}" ErrorLine="{Binding ActiveTab.ErrorLine}"
                                  IsReadOnly="{Binding ActiveTab.ReadOnly}" Padding="4,6,0,0" AutomationProperties.AutomationId="CodeEditor" />
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>

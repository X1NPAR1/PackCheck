<UserControl x:Class="PackCheck.App.Views.PluginsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:PackCheck.App.Infrastructure"
             AutomationProperties.AutomationId="BrowsePage">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis" />
        <l:NullToVisibility x:Key="NullVis" />
        <l:IndexToBool x:Key="IndexBool" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title -->
        <DockPanel Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Visibility="{Binding HasTarget, Converter={StaticResource BoolVis}}">
                <TextBlock Text="{l:Loc Plugins_Target}" Style="{StaticResource Label}" Margin="0,0,0,4" />
                <ComboBox Width="250" ItemsSource="{Binding Targets}" SelectedItem="{Binding TargetServer}" AutomationProperties.AutomationId="BrowseTarget">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock><Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding PlatformText, Mode=OneWay}" Foreground="{DynamicResource TextMutedBrush}" /></TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
            <StackPanel>
                <TextBlock Style="{StaticResource H1}">
                    <TextBlock.Text>
                        <Binding Path="IsModPage" Converter="{x:Static l:PageTitle.Instance}" />
                    </TextBlock.Text>
                </TextBlock>
                <TextBlock Text="{l:Loc Mods_Subtitle}" Style="{StaticResource Muted}" Margin="0,4,0,0" />
            </StackPanel>
        </DockPanel>

        <!-- Filters -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14" Visibility="{Binding HasTarget, Converter={StaticResource BoolVis}}">
            <StackPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Command="{Binding SearchCommand}" Margin="8,0,0,0" IsDefault="True" AutomationProperties.AutomationId="BrowseSearch">
                        <TextBlock Text="{l:Loc Browse_Search}" />
                    </Button>
                    <ComboBox DockPanel.Dock="Right" Width="170" Margin="8,0,0,0" ItemsSource="{Binding SortKeys}" SelectedIndex="{Binding SortIndex}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding Converter={x:Static l:LocKey.Instance}}" /></DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <ComboBox DockPanel.Dock="Right" Width="140" Margin="8,0,0,0" ItemsSource="{Binding Sources}" SelectedItem="{Binding Source}" AutomationProperties.AutomationId="BrowseSource">
                        <ComboBox.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding}" /></DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" ToolTip="{l:Loc Plugins_Search}" AutomationProperties.Name="{l:Loc Plugins_Search}" AutomationProperties.AutomationId="BrowseQuery" />
                </DockPanel>
                <DockPanel Margin="0,12,0,0">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding ResultsText}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource TabPill}" Content="{l:Loc Mods_KindMods}" Visibility="{Binding IsModPage, Converter={StaticResource BoolVis}}"
                                     IsChecked="{Binding ShowModpacks, Converter={x:Static l:Inverse.Bool}}" />
                        <RadioButton Style="{StaticResource TabPill}" Content="{l:Loc Mods_KindPacks}" Visibility="{Binding IsModPage, Converter={StaticResource BoolVis}}"
                                     IsChecked="{Binding ShowModpacks}" />
                        <CheckBox Content="{l:Loc Browse_CompatibleOnly}" IsChecked="{Binding CompatibleOnly}" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </StackPanel>
                </DockPanel>
                <TextBlock Text="{Binding Error}" Foreground="{DynamicResource WarnBrush}" Margin="0,10,0,0" TextWrapping="Wrap" Visibility="{Binding Error, Converter={StaticResource NullVis}}" />
            </StackPanel>
        </Border>

        <!-- No suitable server -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="48" Visibility="{Binding HasTarget, Converter={x:Static l:Inverse.Visibility}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440">
                <Image Source="/Assets/cube-256.png" Width="80" Opacity="0.9" />
                <TextBlock Text="{l:Loc Browse_NoServerTitle}" Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,16,0,6" />
                <TextBlock Style="{StaticResource Muted}" TextAlignment="Center">
                    <TextBlock.Text>
                        <Binding Path="IsModPage" Converter="{x:Static l:NoServerText.Instance}" />
                    </TextBlock.Text>
                </TextBlock>
                <Button Content="{l:Loc Servers_New}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Margin="0,18,0,0" Click="OnCreateServer" />
            </StackPanel>
        </Border>

        <!-- Results -->
        <Grid Grid.Row="2" Margin="0,14,0,0" Visibility="{Binding HasTarget, Converter={StaticResource BoolVis}}">
            <ProgressBar IsIndeterminate="True" VerticalAlignment="Top" Visibility="{Binding IsLoading, Converter={StaticResource BoolVis}}" />
            <ScrollViewer x:Name="ResultsScroll" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                <ItemsControl ItemsSource="{Binding Rows}" l:Anim.Stagger="True" AutomationProperties.AutomationId="BrowseResults">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,8">
                                <DockPanel>
                                    <Border DockPanel.Dock="Left" Width="48" Height="48" CornerRadius="9" Background="{DynamicResource Surface2Brush}" Margin="0,0,14,0" ClipToBounds="True">
                                        <Image Source="{Binding Item.Icon, Converter={x:Static l:UriToImage.Instance}}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Border>

                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                        <Button Style="{StaticResource GhostButton}" Content="↗" ToolTip="{Binding Item.Page}" Command="{Binding DataContext.OpenPageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Margin="0,0,6,0" />
                                        <Border CornerRadius="7" Padding="12,8" Background="{DynamicResource PrimarySoftBrush}" Visibility="{Binding Installed, Converter={StaticResource BoolVis}}">
                                            <TextBlock Text="{l:Loc Browse_Installed}" FontWeight="SemiBold" Foreground="{DynamicResource PassBrush}" />
                                        </Border>
                                        <StackPanel Orientation="Horizontal" Visibility="{Binding Installed, Converter={x:Static l:Inverse.Visibility}}">
                                            <Button Content="{l:Loc Plugins_Install}" Style="{StaticResource PrimaryButton}" IsEnabled="{Binding CanInstall}"
                                                    Command="{Binding DataContext.InstallCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                            <Border Width="28" Height="28" CornerRadius="14" Margin="6,0,0,0" Background="{DynamicResource Surface2Brush}" Cursor="Help"
                                                    ToolTip="{Binding IncompatibleReason}" ToolTipService.InitialShowDelay="100"
                                                    Visibility="{Binding Compatible, Converter={x:Static l:Inverse.Visibility}}" AutomationProperties.Name="{Binding IncompatibleReason}">
                                                <Path Data="{StaticResource IconClose}" Style="{StaticResource IconPath}" Width="10" Height="10" Stroke="{DynamicResource FailBrush}" />
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock>
                                            <Run Text="{Binding Item.Title, Mode=OneWay}" FontWeight="SemiBold" FontSize="14" />
                                            <Run Text="{Binding Item.Author, Mode=OneWay, StringFormat=' · {0}'}" Foreground="{DynamicResource TextMutedBrush}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding Item.Description}" Style="{StaticResource Muted}" FontSize="12.5" TextTrimming="CharacterEllipsis" Margin="0,2,0,4" />
                                        <TextBlock FontSize="12" Foreground="{DynamicResource TextFaintBrush}">
                                            <Run Text="{Binding Downloads, Mode=OneWay}" />
                                            <Run Text="·" />
                                            <Run Text="{Binding VersionRange, Mode=OneWay}" />
                                            <Run Text="·" />
                                            <Run Text="{Binding Item.Provider, Mode=OneWay}" Foreground="{DynamicResource PrimaryBrush}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock Text="{l:Loc Browse_Empty}" Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding HasRows, Converter={x:Static l:Inverse.Visibility}}" />
        </Grid>

        <!-- Pagination -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0" Visibility="{Binding HasRows, Converter={StaticResource BoolVis}}"
                    AutomationProperties.AutomationId="Pagination">
            <Button Content="‹" Command="{Binding PrevCommand}" Padding="12,6" Margin="0,0,6,0" AutomationProperties.Name="{l:Loc Common_Back}" />
            <ItemsControl ItemsSource="{Binding Pages}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <TextBlock Text="…" Margin="6,0" VerticalAlignment="Center" Style="{StaticResource Muted}" Visibility="{Binding IsGap, Converter={StaticResource BoolVis}}" />
                            <Button Content="{Binding Label}" MinWidth="38" Padding="10,6" Margin="0,0,6,0" Visibility="{Binding IsGap, Converter={x:Static l:Inverse.Visibility}}"
                                    Command="{Binding DataContext.GoToPageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Index}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource BaseButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="›" Command="{Binding NextCommand}" Padding="12,6" AutomationProperties.Name="{l:Loc Common_Next}" />
        </StackPanel>
    </Grid>
</UserControl>

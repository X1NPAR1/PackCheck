<UserControl x:Class="PackCheck.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:PackCheck.App.Infrastructure"
             AutomationProperties.AutomationId="DashboardPage">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis" />
        <l:StatusBrush x:Key="StatusBrush" />
        <Style x:Key="Stat" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Margin" Value="0,0,12,12" />
        </Style>
        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <DockPanel Margin="0,0,0,6">
                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Command="{Binding NewServerCommand}" VerticalAlignment="Center" AutomationProperties.AutomationId="DashNewServer">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconPlus}" Style="{StaticResource IconPath}" Width="14" Height="14" Stroke="White" Margin="0,0,8,0" />
                        <TextBlock Text="{l:Loc Servers_New}" />
                    </StackPanel>
                </Button>
                <TextBlock Text="{l:Loc Dash_Title}" Style="{StaticResource H1}" />
            </DockPanel>
            <TextBlock Text="{l:Loc Dash_Subtitle}" Style="{StaticResource Muted}" Margin="0,0,0,18" />

            <UniformGrid Columns="4" Margin="0,0,-12,0">
                <Border Style="{StaticResource Stat}">
                    <StackPanel>
                        <TextBlock Text="{l:Loc Dash_ServersOnline}" Style="{StaticResource StatLabel}" />
                        <TextBlock Text="{Binding RunningText}" Style="{StaticResource StatValue}" Foreground="{DynamicResource PassBrush}" AutomationProperties.AutomationId="DashRunning" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Stat}">
                    <StackPanel>
                        <TextBlock Text="{l:Loc Dash_Players}" Style="{StaticResource StatLabel}" />
                        <TextBlock Text="{Binding Players}" Style="{StaticResource StatValue}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Stat}">
                    <StackPanel>
                        <TextBlock Text="{l:Loc Dash_Memory}" Style="{StaticResource StatLabel}" />
                        <TextBlock Text="{Binding AllottedText}" Style="{StaticResource StatValue}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Stat}">
                    <StackPanel>
                        <TextBlock Text="{l:Loc Dash_Crashes}" Style="{StaticResource StatLabel}" />
                        <TextBlock Text="{Binding Crashes24h}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource StatValue}">
                                    <Setter Property="Foreground" Value="{DynamicResource FailBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Crashes24h}" Value="0"><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <TextBlock Text="{Binding StatusLine}" Style="{StaticResource Muted}" Margin="2,2,0,14" />

            <TextBlock Text="{l:Loc Dash_LiveUsage}" Style="{StaticResource H2}" Margin="0,0,0,10" />
            <TextBlock Text="{l:Loc Servers_Empty}" Style="{StaticResource Muted}" Visibility="{Binding IsEmpty, Converter={StaticResource BoolVis}}" />
            <ItemsControl ItemsSource="{Binding Rows}" AutomationProperties.AutomationId="DashRows">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,8">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="{l:Loc Dash_Open}" Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                        VerticalAlignment="Center" Margin="12,0,0,0" AutomationProperties.Name="{Binding Name}" />
                                <Grid Width="34" Height="34" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <Border CornerRadius="7" Background="{DynamicResource Surface3Brush}" />
                                    <Image Source="{Binding Icon}" Visibility="{Binding HasIcon, Converter={StaticResource BoolVis}}" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                    <Image Source="/Assets/cube-256.png" Margin="5" Visibility="{Binding HasIcon, Converter={x:Static l:Inverse.Visibility}}" />
                                </Grid>
                                <StackPanel DockPanel.Dock="Left" Width="230" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="{Binding State, Converter={StaticResource StatusBrush}}" Margin="0,0,7,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding PlatformText}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="15,2,0,0" />
                                </StackPanel>
                                <UniformGrid Columns="4" VerticalAlignment="Center">
                                    <StackPanel><TextBlock Text="TPS" Style="{StaticResource StatLabel}" /><TextBlock Text="{Binding Tps.Text}" FontWeight="SemiBold" /></StackPanel>
                                    <StackPanel><TextBlock Text="CPU" Style="{StaticResource StatLabel}" /><TextBlock Text="{Binding Cpu.Text}" FontWeight="SemiBold" /></StackPanel>
                                    <StackPanel><TextBlock Text="RAM" Style="{StaticResource StatLabel}" /><TextBlock Text="{Binding Ram.Text}" FontWeight="SemiBold" /></StackPanel>
                                    <StackPanel><TextBlock Text="{l:Loc Dash_PlayersShort}" Style="{StaticResource StatLabel}" /><TextBlock Text="{Binding PlayersText}" FontWeight="SemiBold" /></StackPanel>
                                </UniformGrid>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>

<UserControl x:Class="PackCheck.App.Views.AssistantView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:PackCheck.App.Infrastructure"
             AutomationProperties.AutomationId="AssistantPage">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis" />
        <l:NullToVisibility x:Key="NullVis" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Run Text="{Binding ModelText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding TokensText, Mode=OneWay}" />
                </TextBlock>
                <Button Content="{l:Loc Assistant_New}" Command="{Binding NewChatCommand}" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="{l:Loc Assistant_Title}" Style="{StaticResource H1}" />
                <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0"><Run Text="{l:Loc Assistant_Subtitle}" /><Run Text=" " /><Run Text="{Binding ServerText, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock>
            </StackPanel>
        </DockPanel>

        <!-- not configured -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="40" Visibility="{Binding IsConfigured, Converter={x:Static l:Inverse.Visibility}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460">
                <TextBlock Text="{l:Loc Assistant_SetupTitle}" Style="{StaticResource H2}" HorizontalAlignment="Center" />
                <TextBlock Text="{l:Loc Assistant_SetupBody}" Style="{StaticResource Muted}" TextAlignment="Center" Margin="0,8,0,0" />
                <Button Content="{l:Loc Nav_Settings}" Style="{StaticResource PrimaryButton}" Command="{Binding OpenSettingsCommand}" HorizontalAlignment="Center" Margin="0,18,0,0" />
            </StackPanel>
        </Border>

        <!-- conversation -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" Visibility="{Binding IsConfigured, Converter={StaticResource BoolVis}}">
            <Grid>
                <TextBlock Text="{l:Loc Assistant_Empty}" Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" MaxWidth="460"
                           Visibility="{Binding Messages.Count, Converter={x:Static l:Inverse.Visibility}}" />
                <ScrollViewer x:Name="Scroll" VerticalScrollBarVisibility="Auto" Padding="18,14">
                    <ItemsControl ItemsSource="{Binding Messages}" AutomationProperties.AutomationId="ChatMessages">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ContentControl Content="{Binding}" Focusable="False">
                                    <ContentControl.Style>
                                        <Style TargetType="ContentControl">
                                            <Setter Property="ContentTemplate">
                                                <Setter.Value>
                                                    <DataTemplate>
                                                        <Border Margin="0,0,80,10" Padding="14,10" CornerRadius="10" Background="{DynamicResource Surface2Brush}" HorizontalAlignment="Left">
                                                            <StackPanel>
                                                                <RichTextBox l:Markdown.Source="{Binding Text}" IsReadOnly="True" IsDocumentEnabled="True" BorderThickness="0" Background="Transparent"
                                                                             Padding="0" MinHeight="0" FontSize="13.5" VerticalScrollBarVisibility="Disabled" AutomationProperties.AutomationId="AssistantAnswer" />
                                                                <TextBlock Text="▍" Foreground="{DynamicResource PrimaryBrush}" Visibility="{Binding IsStreaming, Converter={StaticResource BoolVis}}" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Role}" Value="user">
                                                    <Setter Property="ContentTemplate">
                                                        <Setter.Value>
                                                            <DataTemplate>
                                                                <Border Margin="80,0,0,10" Padding="14,10" CornerRadius="10" Background="{DynamicResource PrimarySoftBrush}" HorizontalAlignment="Right">
                                                                    <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" TextWrapping="Wrap" Padding="0" MinHeight="0" />
                                                                </Border>
                                                            </DataTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Role}" Value="plan">
                                                    <Setter Property="ContentTemplate">
                                                        <Setter.Value>
                                                            <DataTemplate>
                                                                <StackPanel Orientation="Horizontal" Margin="4,0,0,12">
                                                                    <Button Content="{l:Loc Mode_RunPlan}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" AutomationProperties.AutomationId="RunPlan"
                                                                            Command="{Binding DataContext.RunPlanCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="normal" />
                                                                    <Button Content="{l:Loc Mode_RunPlanAuto}"
                                                                            Command="{Binding DataContext.RunPlanCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="auto" />
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Role}" Value="tool">
                                                    <Setter Property="ContentTemplate">
                                                        <Setter.Value>
                                                            <DataTemplate>
                                                                <StackPanel Margin="0,0,80,6">
                                                                    <Button Command="{Binding ToggleCommand}" Cursor="Hand" HorizontalAlignment="Left" AutomationProperties.Name="{Binding Text}">
                                                                        <Button.Template>
                                                                            <ControlTemplate TargetType="Button">
                                                                                <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="6,3"><ContentPresenter /></Border>
                                                                                <ControlTemplate.Triggers>
                                                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface2Brush}" /></Trigger>
                                                                                </ControlTemplate.Triggers>
                                                                            </ControlTemplate>
                                                                        </Button.Template>
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <TextBlock Text="▸" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,7,0" RenderTransformOrigin="0.5,0.5">
                                                                                <TextBlock.Style>
                                                                                    <Style TargetType="TextBlock">
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                                                                                <Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="90" /></Setter.Value></Setter>
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </TextBlock.Style>
                                                                            </TextBlock>
                                                                            <Path Data="{StaticResource IconValidate}" Style="{StaticResource IconPath}" Width="12" Height="12" Stroke="{DynamicResource PassBrush}" Margin="0,0,7,0" />
                                                                            <TextBlock Text="{Binding Text}" FontSize="12.5" Foreground="{DynamicResource TextMutedBrush}" />
                                                                        </StackPanel>
                                                                    </Button>
                                                                    <Border Visibility="{Binding IsOpen, Converter={StaticResource BoolVis}}" Margin="22,4,0,4" CornerRadius="8" Background="{DynamicResource ConsoleBgBrush}" Padding="12,10" l:Anim.PopIn="True">
                                                                        <StackPanel>
                                                                            <TextBlock Text="{l:Loc Tool_Input}" FontSize="11" Foreground="{DynamicResource ConsoleMutedBrush}" Visibility="{Binding Arguments, Converter={StaticResource NullVis}}" />
                                                                            <TextBox Text="{Binding Arguments, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource ConsoleTextBrush}" Padding="0" MinHeight="0"
                                                                                     FontFamily="{StaticResource MonoFont}" FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,8" Visibility="{Binding Arguments, Converter={StaticResource NullVis}}" />
                                                                            <TextBlock Text="{l:Loc Tool_Output}" FontSize="11" Foreground="{DynamicResource ConsoleMutedBrush}" />
                                                                            <TextBox Text="{Binding Result, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource ConsoleTextBrush}" Padding="0" MinHeight="0"
                                                                                     FontFamily="{StaticResource MonoFont}" FontSize="11.5" TextWrapping="NoWrap" MaxHeight="320" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="0,2,0,0" />
                                                                        </StackPanel>
                                                                    </Border>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Role}" Value="system">
                                                    <Setter Property="ContentTemplate">
                                                        <Setter.Value>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding Text}" Foreground="{DynamicResource WarnBrush}" TextWrapping="Wrap" Margin="4,0,0,10" />
                                                            </DataTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Role}" Value="approval">
                                                    <Setter Property="ContentTemplate">
                                                        <Setter.Value>
                                                            <DataTemplate>
                                                                <Border Margin="0,0,40,12" Padding="14,12" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource WarnBrush}" Background="{DynamicResource SurfaceBrush}">
                                                                    <StackPanel>
                                                                        <TextBlock FontWeight="SemiBold"><Run Text="{l:Loc Assistant_Approve}" /><Run Text=": " /><Run Text="{Binding Text, Mode=OneWay}" /></TextBlock>
                                                                        <Border Background="{DynamicResource ConsoleBgBrush}" CornerRadius="6" Padding="10,8" Margin="0,8,0,0" MaxHeight="260">
                                                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                                                <TextBlock Text="{Binding Pending.Preview}" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{DynamicResource ConsoleTextBrush}" TextWrapping="Wrap" />
                                                                            </ScrollViewer>
                                                                        </Border>
                                                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0" Visibility="{Binding IsWaiting, Converter={StaticResource BoolVis}}">
                                                                            <Button Content="{l:Loc Assistant_Allow}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                                                                                    Command="{Binding DataContext.ApproveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                                            <Button Content="{l:Loc Assistant_Deny}" Style="{StaticResource DangerButton}"
                                                                                    Command="{Binding DataContext.RejectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                                        </StackPanel>
                                                                        <TextBlock Margin="0,8,0,0" FontSize="12" Visibility="{Binding Approved, Converter={StaticResource NullVis}}">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Setter Property="Text" Value="{l:Loc Assistant_Denied}" />
                                                                                    <Setter Property="Foreground" Value="{DynamicResource FailBrush}" />
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding Approved}" Value="True">
                                                                                            <Setter Property="Text" Value="{l:Loc Assistant_Allowed}" />
                                                                                            <Setter Property="Foreground" Value="{DynamicResource PassBrush}" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ContentControl.Style>
                                </ContentControl>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- bypass warning -->
        <Border Grid.Row="2" VerticalAlignment="Top" Margin="0,-30,0,0" Padding="10,4" CornerRadius="6" Background="{DynamicResource FailBrush}" HorizontalAlignment="Left"
                Visibility="{Binding IsBypass, Converter={StaticResource BoolVis}}">
            <TextBlock Text="{l:Loc Mode_BypassBanner}" Foreground="White" FontSize="12" FontWeight="SemiBold" />
        </Border>

        <!-- input -->
        <DockPanel Grid.Row="2" Margin="0,12,0,0" Visibility="{Binding IsConfigured, Converter={StaticResource BoolVis}}">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Content="{l:Loc Common_Cancel}" Command="{Binding CancelCommand}" Margin="8,0,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}" />
                <Button Content="{l:Loc Console_Send}" Style="{StaticResource PrimaryButton}" Command="{Binding SendCommand}" Margin="8,0,0,0" AutomationProperties.AutomationId="AssistantSend" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Left" Margin="0,0,8,0" VerticalAlignment="Bottom" Width="190">
                <TextBlock Text="{Binding ModeHint}" FontSize="11.5" TextWrapping="Wrap" Margin="2,0,0,6" Foreground="{DynamicResource TextMutedBrush}" />
                <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}" AutomationProperties.AutomationId="AssistantMode" AutomationProperties.Name="{l:Loc Mode_Label}" ToolTip="{l:Loc Mode_Label}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={x:Static l:LocKey.Prefixed}, ConverterParameter=Mode_}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Content="{l:Loc Assistant_AttachConsole}" Command="{Binding AttachConsoleCommand}" Margin="0,6,0,0" />
            </StackPanel>
            <TextBox x:Name="InputBox" Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" Tag="{l:Loc Assistant_InputHint}" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="160"
                     VerticalScrollBarVisibility="Auto" PreviewKeyDown="OnKey" AutomationProperties.AutomationId="AssistantInput" />
        </DockPanel>
        <ProgressBar Grid.Row="2" IsIndeterminate="True" VerticalAlignment="Top" Margin="0,4,0,0" Height="3" Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}" />
    </Grid>
</UserControl>

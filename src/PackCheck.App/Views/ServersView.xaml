<UserControl x:Class="PackCheck.App.Views.ServersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:PackCheck.App.Infrastructure"
             AutomationProperties.AutomationId="ServersPage">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis" />
        <l:NullToVisibility x:Key="NullVis" />
        <l:StatusBrush x:Key="StatusBrush" />
        <l:IndexToBool x:Key="IndexBool" />
        <l:IndexToVisibility x:Key="IndexVis" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,20">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="{l:Loc Servers_Import}" Command="{Binding ImportServerCommand}" Margin="0,0,8,0" />
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding NewServerCommand}" AutomationProperties.AutomationId="NewServer">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconPlus}" Style="{StaticResource IconPath}" Width="13" Height="13" Stroke="{DynamicResource OnPrimaryBrush}" />
                        <TextBlock Text="{l:Loc Servers_New}" Margin="8,0,0,0" Foreground="{DynamicResource OnPrimaryBrush}" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <TextBlock Text="{l:Loc Servers_Title}" Style="{StaticResource H1}" />
        </DockPanel>

        <!-- Empty state -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Visibility="{Binding IsEmpty, Converter={StaticResource BoolVis}}" Padding="48">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                <Image Source="/Assets/cube-256.png" Width="96" Opacity="0.9" />
                <TextBlock Text="{l:Loc Servers_Empty}" Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,18,0,6" />
                <TextBlock Text="{l:Loc Servers_EmptyHint}" Style="{StaticResource Muted}" TextAlignment="Center" />
                <Button Content="{l:Loc Servers_New}" Style="{StaticResource PrimaryButton}" Command="{Binding NewServerCommand}" HorizontalAlignment="Center" Margin="0,20,0,0" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Visibility="{Binding IsEmpty, Converter={x:Static l:Inverse.Visibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <!-- Server list -->
            <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" Background="Transparent" BorderThickness="0" l:Anim.Stagger="True"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.AutomationId="ServerList">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="0,0,0,8" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="14,12" Cursor="Hand">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface2Brush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface2Brush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <Grid DockPanel.Dock="Left" Width="10" Height="10" Margin="0,0,12,0" VerticalAlignment="Center">
                                <Ellipse Fill="{Binding State, Converter={StaticResource StatusBrush}}" />
                                <Ellipse x:Name="Pulse" Fill="{Binding State, Converter={StaticResource StatusBrush}}" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform><ScaleTransform /></Ellipse.RenderTransform>
                                </Ellipse>
                            </Grid>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" FontSize="12" />
                            </StackPanel>
                        </DockPanel>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard x:Name="PulseAnim">
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="Pulse" Storyboard.TargetProperty="Opacity" From="0.6" To="0" Duration="0:0:1.6" />
                                            <DoubleAnimation Storyboard.TargetName="Pulse" Storyboard.TargetProperty="RenderTransform.ScaleX" From="1" To="2.6" Duration="0:0:1.6" />
                                            <DoubleAnimation Storyboard.TargetName="Pulse" Storyboard.TargetProperty="RenderTransform.ScaleY" From="1" To="2.6" Duration="0:0:1.6" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="PulseAnim" />
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Detail -->
            <Grid Grid.Column="2" DataContext="{Binding Selected}" Visibility="{Binding Converter={StaticResource NullVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding StartCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,6,0" Visibility="{Binding IsBusy, Converter={x:Static l:Inverse.Visibility}}" AutomationProperties.AutomationId="StartServer">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconPlay}" Style="{StaticResource IconPath}" Width="11" Height="11" Fill="{DynamicResource OnPrimaryBrush}" Stroke="{DynamicResource OnPrimaryBrush}" />
                                <TextBlock Text="{l:Loc Servers_Start}" Margin="8,0,0,0" Foreground="{DynamicResource OnPrimaryBrush}" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding StopCommand}" Content="{l:Loc Servers_Stop}" Margin="0,0,6,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}" AutomationProperties.AutomationId="StopServer" />
                        <Button Command="{Binding RestartCommand}" Content="{l:Loc Servers_Restart}" Margin="0,0,6,0" Visibility="{Binding IsRunning, Converter={StaticResource BoolVis}}" />
                        <Button Command="{Binding KillCommand}" Content="{l:Loc Servers_Kill}" Style="{StaticResource DangerButton}" Margin="0,0,6,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}" />
                        <Button Command="{Binding ValidateServerCommand}" Content="{l:Loc Servers_Validate}" Margin="0,0,6,0" />
                        <Button Command="{Binding OpenFolderCommand}" Style="{StaticResource GhostButton}" ToolTip="{l:Loc Common_OpenFolder}" AutomationProperties.Name="{l:Loc Common_OpenFolder}">
                            <Path Data="{StaticResource IconFolder}" Style="{StaticResource IconPath}" Stroke="{DynamicResource TextMutedBrush}" />
                        </Button>
                        <Button Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource GhostButton}" ToolTip="{l:Loc Servers_Remove}" AutomationProperties.Name="{l:Loc Servers_Remove}">
                            <Path Data="{StaticResource IconClose}" Style="{StaticResource IconPath}" Width="13" Stroke="{DynamicResource TextMutedBrush}" />
                        </Button>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{Binding Name}" Style="{StaticResource H2}" FontSize="22" TextTrimming="CharacterEllipsis" />
                        <TextBlock Margin="0,2,0,0">
                            <Run Text="{Binding StateText, Mode=OneWay}" Foreground="{Binding State, Converter={StaticResource StatusBrush}}" FontWeight="SemiBold" />
                            <Run Text="  ·  " Foreground="{DynamicResource TextFaintBrush}" />
                            <Run Text="{Binding Subtitle, Mode=OneWay}" Foreground="{DynamicResource TextMutedBrush}" />
                        </TextBlock>
                    </StackPanel>
                </DockPanel>

                <!-- Stats -->
                <UniformGrid Grid.Row="1" Columns="3" Margin="0,16,0,0">
                    <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="{l:Loc Servers_Memory}" Style="{StaticResource Muted}" FontSize="12" />
                            <TextBlock Text="{Binding MemoryText}" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="20" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="14,10" Margin="4,0">
                        <StackPanel>
                            <TextBlock Text="{l:Loc Servers_Cpu}" Style="{StaticResource Muted}" FontSize="12" />
                            <TextBlock Text="{Binding CpuText}" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="20" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="14,10" Margin="8,0,0,0">
                        <l:Sparkline Values="{Binding MemoryHistory}" Stroke="{DynamicResource PrimaryBrush}" Height="40" />
                    </Border>
                </UniformGrid>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,16,0,10">
                    <RadioButton Style="{StaticResource TabPill}" Content="{l:Loc Servers_Console}" IsChecked="{Binding Tab, Converter={StaticResource IndexBool}, ConverterParameter=0}" />
                    <RadioButton Style="{StaticResource TabPill}" Content="{l:Loc Servers_Properties}" IsChecked="{Binding Tab, Converter={StaticResource IndexBool}, ConverterParameter=1}" />
                    <RadioButton Style="{StaticResource TabPill}" Content="{l:Loc Servers_PluginsTab}" IsChecked="{Binding Tab, Converter={StaticResource IndexBool}, ConverterParameter=2}" />
                    <RadioButton Style="{StaticResource TabPill}" Content="{l:Loc Servers_Backups}" IsChecked="{Binding Tab, Converter={StaticResource IndexBool}, ConverterParameter=3}" />
                </StackPanel>

                <!-- Console -->
                <Border Grid.Row="3" CornerRadius="10" Background="{DynamicResource ConsoleBgBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                        Visibility="{Binding Tab, Converter={x:Static l:Inverse.Visibility}}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Bottom" Margin="10">
                            <TextBox DockPanel.Dock="Right" Width="180" Margin="8,0,0,0" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" ToolTip="{l:Loc Servers_Filter}" AutomationProperties.Name="{l:Loc Servers_Filter}" />
                            <TextBox x:Name="CommandBox" FontFamily="{StaticResource MonoFont}" Text="{Binding Command, UpdateSourceTrigger=PropertyChanged}" PreviewKeyDown="OnCommandKey"
                                     ToolTip="{l:Loc Servers_CommandHint}" AutomationProperties.Name="{l:Loc Servers_CommandHint}" AutomationProperties.AutomationId="ConsoleInput" />
                        </DockPanel>
                        <ListBox ItemsSource="{Binding Console}" Background="Transparent" BorderThickness="0" Padding="12,10,4,0" l:Anim.AutoScroll="True"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" AutomationProperties.AutomationId="ConsoleOutput">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Text}" FontFamily="{StaticResource MonoFont}" FontSize="12.5" TextWrapping="Wrap" Foreground="{Binding Level, Converter={StaticResource StatusBrush}}" Opacity="0.95" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- Properties -->
                <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0" Visibility="{Binding Tab, Converter={StaticResource IndexVis}, ConverterParameter=1}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Bottom" Margin="14">
                            <Button DockPanel.Dock="Right" Content="{l:Loc Common_Save}" Style="{StaticResource PrimaryButton}" Command="{Binding SavePropertiesCommand}" />
                            <TextBlock Text="{l:Loc Servers_SaveWhileRunning}" Style="{StaticResource Muted}" VerticalAlignment="Center" Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}" />
                        </DockPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,14,14,0">
                            <ItemsControl ItemsSource="{Binding Properties}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="240" />
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Key}" FontFamily="{StaticResource MonoFont}" FontSize="12.5" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
                                            <TextBox Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}" Padding="8,5" AutomationProperties.Name="{Binding Key}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- Plugins -->
                <Border Grid.Row="3" Style="{StaticResource Card}" Visibility="{Binding Tab, Converter={StaticResource IndexVis}, ConverterParameter=2}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <Button DockPanel.Dock="Right" Content="{l:Loc Plugins_AddFile}" Command="{Binding AddPluginFileCommand}" />
                            <TextBlock Text="{l:Loc Plugins_Installed_List}" Style="{StaticResource H2}" FontSize="15" VerticalAlignment="Center" />
                        </DockPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding PluginList}" l:Anim.Stagger="True">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,9">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Command="{Binding DataContext.TogglePluginCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Padding="12,6">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource BaseButton}">
                                                            <Setter Property="Content" Value="{l:Loc Plugins_Disable}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                                    <Setter Property="Content" Value="{l:Loc Plugins_Enable}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <StackPanel>
                                                    <TextBlock FontWeight="SemiBold">
                                                        <Run Text="{Binding Name, Mode=OneWay, TargetNullValue='?'}" />
                                                        <Run Text="{Binding Version, Mode=OneWay}" Foreground="{DynamicResource TextMutedBrush}" FontWeight="Normal" />
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding File}" Style="{StaticResource Muted}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- Backups -->
                <Border Grid.Row="3" Style="{StaticResource Card}" Visibility="{Binding Tab, Converter={StaticResource IndexVis}, ConverterParameter=3}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <Button DockPanel.Dock="Right" Content="{l:Loc Backups_Create}" Style="{StaticResource PrimaryButton}" Command="{Binding CreateBackupCommand}" />
                            <TextBlock Text="{l:Loc Servers_Backups}" Style="{StaticResource H2}" FontSize="15" VerticalAlignment="Center" />
                        </DockPanel>
                        <Grid>
                            <TextBlock Text="{l:Loc Backups_Empty}" Style="{StaticResource Muted}" Visibility="{Binding BackupList.Count, Converter={x:Static l:Inverse.Visibility}}" />
                            <ItemsControl ItemsSource="{Binding BackupList}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Content="{l:Loc Backups_Restore}" Padding="12,6"
                                                        Command="{Binding DataContext.RestoreBackupCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                                <TextBlock VerticalAlignment="Center">
                                                    <Run Text="{Binding CreatedAt, Mode=OneWay, StringFormat=g}" />
                                                    <Run Text="{Binding Size, Mode=OneWay, Converter={x:Static l:Bytes.Instance}}" Foreground="{DynamicResource TextMutedBrush}" />
                                                </TextBlock>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Create wizard overlay -->
        <Grid Grid.RowSpan="2" Margin="-32,-44,-32,-24" Background="{DynamicResource OverlayBrush}" DataContext="{Binding Wizard}" Visibility="{Binding Converter={StaticResource NullVis}}">
            <Border Style="{StaticResource Card}" Width="600" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28" l:Anim.PopIn="True" AutomationProperties.AutomationId="CreateWizard">
                <StackPanel>
                    <TextBlock Text="{l:Loc Wizard_Title}" Style="{StaticResource H1}" FontSize="24" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{l:Loc Wizard_Name}" Style="{StaticResource Label}" />
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="WizardName" />
                            <TextBlock Text="{l:Loc Wizard_Platform}" Style="{StaticResource Label}" />
                            <ComboBox ItemsSource="{Binding Platforms}" SelectedItem="{Binding Platform}" />
                            <TextBlock Text="{l:Loc Wizard_Memory}" Style="{StaticResource Label}" />
                            <TextBox Text="{Binding MemoryMb}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{l:Loc Wizard_Folder}" Style="{StaticResource Label}" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="{l:Loc Common_Browse}" Command="{Binding BrowseCommand}" Margin="6,0,0,0" Padding="10,8" />
                                <TextBox Text="{Binding Folder}" />
                            </DockPanel>
                            <TextBlock Text="{l:Loc Wizard_Version}" Style="{StaticResource Label}" />
                            <ComboBox ItemsSource="{Binding Versions}" SelectedItem="{Binding Version}" AutomationProperties.AutomationId="WizardVersion" />
                            <TextBlock Text="{l:Loc Wizard_Seed}" Style="{StaticResource Label}" />
                            <TextBox Text="{Binding Seed}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{l:Loc Wizard_Java}" Style="{StaticResource Label}" />
                    <ComboBox ItemsSource="{Binding Runtimes}" SelectedItem="{Binding Runtime}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding Display}" /></DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <DockPanel Margin="0,8,0,0" Visibility="{Binding NeedsJava, Converter={StaticResource BoolVis}}">
                        <Button DockPanel.Dock="Right" Command="{Binding InstallJavaCommand}" Padding="12,6">
                            <TextBlock Text="{Binding RequiredJava, StringFormat='Temurin {0}'}" />
                        </Button>
                        <TextBlock Text="{Binding JavaHint}" Foreground="{DynamicResource WarnBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </DockPanel>
                    <CheckBox IsChecked="{Binding AcceptEula}" Margin="0,18,0,0" AutomationProperties.AutomationId="WizardEula">
                        <TextBlock Text="{l:Loc Wizard_Eula}" TextWrapping="Wrap" />
                    </CheckBox>
                    <ProgressBar Margin="0,18,0,6" Maximum="1" Value="{Binding Progress}" Visibility="{Binding IsWorking, Converter={StaticResource BoolVis}}" />
                    <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" Margin="0,6,0,0" Visibility="{Binding Status, Converter={StaticResource NullVis}}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button Content="{l:Loc Common_Cancel}" Command="{Binding CancelCommand}" Margin="0,0,8,0" />
                        <Button Content="{l:Loc Wizard_Create}" Style="{StaticResource PrimaryButton}" Command="{Binding CreateCommand}" AutomationProperties.AutomationId="WizardCreate" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>

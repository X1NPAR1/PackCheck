<UserControl x:Class="PackCheck.App.Views.ServersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:PackCheck.App.Infrastructure"
             xmlns:v="clr-namespace:PackCheck.App.Views"
             AutomationProperties.AutomationId="ServersPage">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis" />
        <l:NullToVisibility x:Key="NullVis" />
        <l:StatusBrush x:Key="StatusBrush" />
        <l:IndexToBool x:Key="IndexBool" />
        <l:IndexToVisibility x:Key="IndexVis" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,20">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="{l:Loc Servers_Import}" Command="{Binding ImportServerCommand}" Margin="0,0,8,0" />
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding NewServerCommand}" AutomationProperties.AutomationId="NewServer">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconPlus}" Style="{StaticResource IconPath}" Width="13" Height="13" Stroke="{DynamicResource OnPrimaryBrush}" />
                        <TextBlock Text="{l:Loc Servers_New}" Margin="8,0,0,0" Foreground="{DynamicResource OnPrimaryBrush}" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <TextBlock Text="{l:Loc Servers_Title}" Style="{StaticResource H1}" />
        </DockPanel>

        <!-- Empty state -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Visibility="{Binding IsEmpty, Converter={StaticResource BoolVis}}" Padding="48">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                <Image Source="/Assets/cube-256.png" Width="96" Opacity="0.9" />
                <TextBlock Text="{l:Loc Servers_Empty}" Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,18,0,6" />
                <TextBlock Text="{l:Loc Servers_EmptyHint}" Style="{StaticResource Muted}" TextAlignment="Center" />
                <Button Content="{l:Loc Servers_New}" Style="{StaticResource PrimaryButton}" Command="{Binding NewServerCommand}" HorizontalAlignment="Center" Margin="0,20,0,0" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Visibility="{Binding IsEmpty, Converter={x:Static l:Inverse.Visibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <!-- Server list -->
            <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" Background="Transparent" BorderThickness="0" l:Anim.Stagger="True"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.AutomationId="ServerList">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="0,0,0,8" />
                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="14,12" Cursor="Hand">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface2Brush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface2Brush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <Grid DockPanel.Dock="Left" Width="10" Height="10" Margin="0,0,12,0" VerticalAlignment="Center">
                                <Ellipse Fill="{Binding State, Converter={StaticResource StatusBrush}}" />
                                <Ellipse x:Name="Pulse" Fill="{Binding State, Converter={StaticResource StatusBrush}}" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform><ScaleTransform /></Ellipse.RenderTransform>
                                </Ellipse>
                            </Grid>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" FontSize="12" />
                            </StackPanel>
                        </DockPanel>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard x:Name="PulseAnim">
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="Pulse" Storyboard.TargetProperty="Opacity" From="0.6" To="0" Duration="0:0:1.6" />
                                            <DoubleAnimation Storyboard.TargetName="Pulse" Storyboard.TargetProperty="RenderTransform.ScaleX" From="1" To="2.6" Duration="0:0:1.6" />
                                            <DoubleAnimation Storyboard.TargetName="Pulse" Storyboard.TargetProperty="RenderTransform.ScaleY" From="1" To="2.6" Duration="0:0:1.6" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="PulseAnim" />
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Detail -->
            <v:ServerDetailView Grid.Column="2" DataContext="{Binding Selected}" Visibility="{Binding Selected, Converter={StaticResource NullVis}}" />
        </Grid>

        <!-- Create wizard overlay -->
        <Grid Grid.RowSpan="2" Margin="-32,-44,-32,-24" Background="{DynamicResource OverlayBrush}" DataContext="{Binding Wizard}" Visibility="{Binding Converter={StaticResource NullVis}}">
            <Border Style="{StaticResource Card}" Width="600" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28" l:Anim.PopIn="True" AutomationProperties.AutomationId="CreateWizard">
                <StackPanel>
                    <TextBlock Text="{l:Loc Wizard_Title}" Style="{StaticResource H1}" FontSize="24" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{l:Loc Wizard_Name}" Style="{StaticResource Label}" />
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="WizardName" />
                            <TextBlock Text="{l:Loc Wizard_Platform}" Style="{StaticResource Label}" />
                            <ComboBox ItemsSource="{Binding Platforms}" SelectedItem="{Binding Platform}" />
                            <TextBlock Text="{l:Loc Wizard_Memory}" Style="{StaticResource Label}" />
                            <TextBox Text="{Binding MemoryMb}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{l:Loc Wizard_Folder}" Style="{StaticResource Label}" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="{l:Loc Common_Browse}" Command="{Binding BrowseCommand}" Margin="6,0,0,0" Padding="10,8" />
                                <TextBox Text="{Binding Folder}" />
                            </DockPanel>
                            <TextBlock Text="{l:Loc Wizard_Version}" Style="{StaticResource Label}" />
                            <ComboBox ItemsSource="{Binding Versions}" SelectedItem="{Binding Version}" AutomationProperties.AutomationId="WizardVersion" />
                            <TextBlock Text="{Binding SupportedRange}" Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" />
                            <TextBlock Text="{l:Loc Wizard_Seed}" Style="{StaticResource Label}" />
                            <TextBox Text="{Binding Seed}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{l:Loc Wizard_Java}" Style="{StaticResource Label}" />
                    <ComboBox ItemsSource="{Binding Runtimes}" SelectedItem="{Binding Runtime}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding Display}" /></DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <DockPanel Margin="0,8,0,0" Visibility="{Binding NeedsJava, Converter={StaticResource BoolVis}}">
                        <Button DockPanel.Dock="Right" Command="{Binding InstallJavaCommand}" Padding="12,6">
                            <TextBlock Text="{Binding RequiredJava, StringFormat='Temurin {0}'}" />
                        </Button>
                        <TextBlock Text="{Binding JavaHint}" Foreground="{DynamicResource WarnBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </DockPanel>
                    <CheckBox IsChecked="{Binding AcceptEula}" Margin="0,18,0,0" AutomationProperties.AutomationId="WizardEula">
                        <TextBlock Text="{l:Loc Wizard_Eula}" TextWrapping="Wrap" />
                    </CheckBox>
                    <ProgressBar Margin="0,18,0,6" Maximum="1" Value="{Binding Progress}" Visibility="{Binding IsWorking, Converter={StaticResource BoolVis}}" />
                    <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" Margin="0,6,0,0" Visibility="{Binding Status, Converter={StaticResource NullVis}}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button Content="{l:Loc Common_Cancel}" Command="{Binding CancelCommand}" Margin="0,0,8,0" />
                        <Button Content="{l:Loc Wizard_Create}" Style="{StaticResource PrimaryButton}" Command="{Binding CreateCommand}" AutomationProperties.AutomationId="WizardCreate" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>

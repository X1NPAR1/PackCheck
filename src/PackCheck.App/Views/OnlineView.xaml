<UserControl x:Class="PackCheck.App.Views.OnlineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:PackCheck.App.Infrastructure"
             AutomationProperties.AutomationId="OnlinePage">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis" />
        <l:NullToVisibility x:Key="NullVis" />
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="900" HorizontalAlignment="Left">
            <DockPanel Margin="0,0,0,18">
                <ComboBox DockPanel.Dock="Right" Width="260" VerticalAlignment="Bottom" ItemsSource="{Binding Servers.Items}" SelectedItem="{Binding Server}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock><Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  :" /><Run Text="{Binding Definition.Port, Mode=OneWay}" Foreground="{DynamicResource TextMutedBrush}" /></TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <StackPanel>
                    <TextBlock Text="{l:Loc Online_Title}" Style="{StaticResource H1}" />
                    <TextBlock Text="{l:Loc Online_Subtitle}" Style="{StaticResource Muted}" Margin="0,4,16,0" />
                </StackPanel>
            </DockPanel>

            <!-- status -->
            <Border Style="{StaticResource Card}" Padding="22">
                <StackPanel>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource PrimaryButton}" Command="{Binding GoOnlineCommand}" Visibility="{Binding IsOnline, Converter={x:Static l:Inverse.Visibility}}"
                                    IsEnabled="{Binding IsBusy, Converter={x:Static l:Inverse.Bool}}" AutomationProperties.AutomationId="GoOnline">
                                <TextBlock Text="{l:Loc Online_Open}" />
                            </Button>
                            <Button Style="{StaticResource DangerButton}" Command="{Binding GoOfflineCommand}" Visibility="{Binding IsOnline, Converter={StaticResource BoolVis}}"
                                    IsEnabled="{Binding IsBusy, Converter={x:Static l:Inverse.Bool}}" Content="{l:Loc Online_Close}" AutomationProperties.AutomationId="GoOffline" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="12" Height="12" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource SkipBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource Health0Brush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Margin="10,0,0,0" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="20">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{l:Loc Online_StateLocal}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                <Setter Property="Text" Value="{l:Loc Online_StatePublic}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </DockPanel>
                    <ProgressBar IsIndeterminate="True" Margin="0,14,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}" />
                    <TextBlock Text="{Binding Log}" Style="{StaticResource Muted}" FontSize="12.5" Margin="0,10,0,0" Visibility="{Binding Log, Converter={StaticResource NullVis}}" />

                    <Border Margin="0,16,0,0" Padding="16,12" CornerRadius="8" Background="{DynamicResource Surface2Brush}" Visibility="{Binding Address, Converter={StaticResource NullVis}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="{l:Loc Console_Copy}" Command="{Binding CopyAddressCommand}" />
                            <StackPanel>
                                <TextBlock Text="{l:Loc Online_ShareAddress}" Style="{StaticResource Label}" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding Address}" FontFamily="{StaticResource MonoFont}" FontSize="22" FontWeight="Bold" AutomationProperties.AutomationId="PublicAddress" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border Margin="0,12,0,0" Padding="14,10" CornerRadius="8" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource WarnBrush}" Background="{DynamicResource Surface2Brush}"
                            Visibility="{Binding Warning, Converter={StaticResource NullVis}}">
                        <TextBlock Text="{Binding Warning}" TextWrapping="Wrap" />
                    </Border>

                    <UniformGrid Columns="3" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="{l:Loc Online_PublicIp}" Style="{StaticResource Label}" Margin="0,0,0,2" />
                            <TextBlock Text="{Binding PublicIp, TargetNullValue='–'}" FontFamily="{StaticResource MonoFont}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{l:Loc Online_LocalIp}" Style="{StaticResource Label}" Margin="0,0,0,2" />
                            <TextBlock FontFamily="{StaticResource MonoFont}"><Run Text="{Binding LocalIp, Mode=OneWay, TargetNullValue='–'}" /><Run Text=":" /><Run Text="{Binding Port, Mode=OneWay}" /></TextBlock>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{l:Loc Online_Firewall}" Style="{StaticResource Label}" Margin="0,0,0,2" />
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{l:Loc Online_Closed}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding FirewallOk}" Value="True">
                                                <Setter Property="Text" Value="{l:Loc Online_Allowed}" />
                                                <Setter Property="Foreground" Value="{DynamicResource PassBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </UniformGrid>
                    <TextBlock Text="{l:Loc Online_Note}" Style="{StaticResource Muted}" FontSize="12" Margin="0,14,0,0" TextWrapping="Wrap" />

                    <!-- outside test -->
                    <DockPanel Margin="0,14,0,0">
                        <Button DockPanel.Dock="Left" Content="{l:Loc Online_CheckButton}" Command="{Binding CheckOutsideCommand}" AutomationProperties.AutomationId="OnlineCheckOutside" Margin="0,0,12,0" VerticalAlignment="Top" />
                        <StackPanel>
                            <TextBlock Text="{Binding OutsideResult}" TextWrapping="Wrap" FontWeight="SemiBold" Visibility="{Binding OutsideResult, Converter={StaticResource NullVis}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding OutsideOk}" Value="True"><Setter Property="Foreground" Value="{DynamicResource PassBrush}" /></DataTrigger>
                                            <DataTrigger Binding="{Binding OutsideOk}" Value="False"><Setter Property="Foreground" Value="{DynamicResource FailBrush}" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{l:Loc Online_CheckPrivacy}" Style="{StaticResource Muted}" FontSize="11.5" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- manual port forwarding -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0" AutomationProperties.AutomationId="RouterGuide">
                <StackPanel>
                    <ToggleButton IsChecked="{Binding ShowRouterGuide}" Cursor="Hand">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"><ContentPresenter /></Border></ControlTemplate>
                        </ToggleButton.Template>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{l:Loc Online_GuideToggle}" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" />
                            <StackPanel>
                                <TextBlock Text="{l:Loc Online_GuideTitle}" Style="{StaticResource H2}" FontSize="15" />
                                <TextBlock Text="{l:Loc Online_GuideWhy}" Style="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </ToggleButton>

                    <StackPanel Visibility="{Binding ShowRouterGuide, Converter={StaticResource BoolVis}}" Margin="0,14,0,0" l:Anim.PopIn="True">
                        <!-- values to type into the router -->
                        <TextBlock Text="{l:Loc Online_GuideValues}" Style="{StaticResource Label}" Margin="0,0,0,8" />
                        <Border CornerRadius="8" Background="{DynamicResource Surface2Brush}" Padding="14,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Margin" Value="0,4,18,4" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                    </Style>
                                </Grid.Resources>
                                <TextBlock Text="{l:Loc Online_GName}" Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Grid.Column="1" Text="Minecraft" FontFamily="{StaticResource MonoFont}" />
                                <TextBlock Grid.Row="1" Text="{l:Loc Online_GProtocol}" Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{l:Loc Online_GProtocolValue}" FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="2" Text="{l:Loc Online_GExternal}" Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Port}" FontFamily="{StaticResource MonoFont}" />
                                <TextBlock Grid.Row="3" Text="{l:Loc Online_GInternalIp}" Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding LocalIp, TargetNullValue='–'}" FontFamily="{StaticResource MonoFont}" />
                                <Button Grid.Row="3" Grid.Column="2" Style="{StaticResource GhostButton}" Content="{l:Loc About_Copy}" Padding="8,2" Command="{Binding CopyTextCommand}" CommandParameter="{Binding LocalIp}" />
                                <TextBlock Grid.Row="4" Text="{l:Loc Online_GInternalPort}" Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Port}" FontFamily="{StaticResource MonoFont}" />
                            </Grid>
                        </Border>

                        <!-- steps -->
                        <TextBlock Text="{l:Loc Online_GuideSteps}" Style="{StaticResource Label}" Margin="0,16,0,8" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8" Visibility="{Binding FirewallOk, Converter={x:Static l:Inverse.Visibility}}"><Run Text="0. " FontWeight="SemiBold" /><Run Text="{l:Loc Online_Step0}" Foreground="{DynamicResource WarnBrush}" /></TextBlock>
                        <DockPanel Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Content="{l:Loc Online_OpenRouter}" Command="{Binding OpenRouterCommand}" Margin="12,0,0,0" VerticalAlignment="Top"
                                    Visibility="{Binding RouterAddress, Converter={StaticResource NullVis}}" />
                            <TextBlock TextWrapping="Wrap"><Run Text="1. " FontWeight="SemiBold" /><Run Text="{l:Loc Online_Step1}" /><Run Text=" " /><Run Text="{Binding RouterAddress, Mode=OneWay, StringFormat='http://{0}/', TargetNullValue=''}" FontFamily="{StaticResource MonoFont}" FontWeight="SemiBold" /></TextBlock>
                        </DockPanel>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"><Run Text="2. " FontWeight="SemiBold" /><Run Text="{l:Loc Online_Step2}" /></TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"><Run Text="3. " FontWeight="SemiBold" /><Run Text="{l:Loc Online_Step3}" /></TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"><Run Text="4. " FontWeight="SemiBold" /><Run Text="{l:Loc Online_Step4}" /></TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"><Run Text="5. " FontWeight="SemiBold" /><Run Text="{l:Loc Online_Step5}" /></TextBlock>

                        <!-- common reasons it still fails -->
                        <TextBlock Text="{l:Loc Online_GuideTrouble}" Style="{StaticResource Label}" Margin="0,10,0,8" />
                        <TextBlock Text="{l:Loc Online_Trouble1}" TextWrapping="Wrap" Margin="0,0,0,6" Style="{StaticResource Muted}" FontSize="12.5" />
                        <TextBlock Text="{l:Loc Online_Trouble2}" TextWrapping="Wrap" Margin="0,0,0,6" Style="{StaticResource Muted}" FontSize="12.5" />
                        <TextBlock Text="{l:Loc Online_Trouble3}" TextWrapping="Wrap" Margin="0,0,0,6" Style="{StaticResource Muted}" FontSize="12.5" />
                        <TextBlock Text="{l:Loc Online_Trouble4}" TextWrapping="Wrap" Margin="0,0,0,6" Style="{StaticResource Muted}" FontSize="12.5" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- CGNAT: why forwarding cannot work and what to do instead -->
            <Border Margin="0,14,0,0" AutomationProperties.AutomationId="CgnatGuide">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Card}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CgnatDetected}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource WarnBrush}" />
                                <Setter Property="BorderThickness" Value="2" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="playit.gg ↗" Command="{Binding OpenPlayitCommand}" />
                        <TextBlock Text="{l:Loc Online_CgnatTitle}" Style="{StaticResource H2}" FontSize="15" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Text="{l:Loc Online_CgnatDetected}" Foreground="{DynamicResource WarnBrush}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0"
                               Visibility="{Binding CgnatDetected, Converter={StaticResource BoolVis}}" />
                    <TextBlock Text="{l:Loc Online_CgnatWhat}" TextWrapping="Wrap" Margin="0,8,0,0" />
                    <TextBlock Text="{l:Loc Online_CgnatCheck}" TextWrapping="Wrap" Margin="0,8,0,0" Style="{StaticResource Muted}" FontSize="12.5" />
                    <TextBlock Text="{l:Loc Online_CgnatFixesTitle}" Style="{StaticResource Label}" Margin="0,12,0,6" />
                    <TextBlock Text="{l:Loc Online_CgnatFix1}" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <TextBlock Text="{l:Loc Online_CgnatFix2}" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <TextBlock Text="{l:Loc Online_CgnatFix3}" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <TextBlock Text="{l:Loc Online_CgnatFix4}" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <TextBlock Text="{l:Loc Online_CgnatFix5}" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <TextBlock Text="{l:Loc Online_CgnatDouble}" TextWrapping="Wrap" Margin="0,4,0,0" Style="{StaticResource Muted}" FontSize="12.5" />
                </StackPanel>
            </Border>

            <!-- custom domain -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="{l:Loc Online_DomainTitle}" Style="{StaticResource H2}" FontSize="15" />
                    <TextBlock Text="{l:Loc Online_DomainHint}" Style="{StaticResource Muted}" FontSize="12.5" Margin="0,4,0,10" />
                    <TextBox Tag="play.example.com" Text="{Binding Domain, UpdateSourceTrigger=PropertyChanged, Delay=300}" Width="360" HorizontalAlignment="Left" AutomationProperties.Name="{l:Loc Online_DomainTitle}" />
                    <StackPanel Visibility="{Binding ARecord, Converter={StaticResource NullVis}}" Margin="0,12,0,0">
                        <DockPanel Margin="0,0,0,6">
                            <Button DockPanel.Dock="Right" Content="{l:Loc Console_Copy}" Command="{Binding CopyRecordCommand}" CommandParameter="{Binding ARecord}" Padding="10,5" />
                            <TextBlock Text="{Binding ARecord}" FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center" />
                        </DockPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="{l:Loc Console_Copy}" Command="{Binding CopyRecordCommand}" CommandParameter="{Binding SrvRecord}" Padding="10,5" />
                            <TextBlock Text="{Binding SrvRecord}" FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Text="{l:Loc Online_SrvHint}" Style="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- DuckDNS -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="{l:Loc Online_DuckTitle}" Style="{StaticResource H2}" FontSize="15" />
                    <TextBlock Text="{l:Loc Online_DuckHint}" Style="{StaticResource Muted}" FontSize="12.5" Margin="0,4,0,10" />
                    <StackPanel Orientation="Horizontal">
                        <TextBox Tag="myserver.duckdns.org" Text="{Binding DuckDomain}" Width="220" ToolTip="myserver.duckdns.org" AutomationProperties.Name="DuckDNS" />
                        <PasswordBox x:Name="Token" Width="260" Margin="8,0,0,0" Padding="10,8" PasswordChanged="OnTokenChanged" AutomationProperties.Name="DuckDNS token"
                                     Background="{DynamicResource Surface2Brush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource LineBrush}" />
                        <Button Content="{l:Loc Online_DuckUpdate}" Command="{Binding UpdateDuckCommand}" Margin="8,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

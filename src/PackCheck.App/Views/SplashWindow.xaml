<Window x:Class="PackCheck.App.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:PackCheck.App.Controls"
        Title="PackCheck" Width="560" Height="420" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen" ShowInTaskbar="True" Icon="/Assets/app.ico"
        Foreground="{DynamicResource TextBrush}" AutomationProperties.AutomationId="Splash">
    <Border x:Name="Root" CornerRadius="16" Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Opacity="0">
        <Border.RenderTransform><ScaleTransform x:Name="RootScale" ScaleX="0.96" ScaleY="0.96" CenterX="280" CenterY="210" /></Border.RenderTransform>
        <Grid Margin="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Image x:Name="Logo" Source="/Assets/logo-wordmark.png" Width="360" RenderOptions.BitmapScalingMode="HighQuality"
                   VerticalAlignment="Center" Opacity="0">
                <Image.RenderTransform><TranslateTransform x:Name="LogoShift" Y="14" /></Image.RenderTransform>
            </Image>

            <Grid Grid.Row="1" Width="92" Height="92" Margin="0,8,0,18">
                <c:ProgressRing x:Name="Ring" Thickness="6" Track="{DynamicResource Surface3Brush}" Fill="{DynamicResource PrimaryBrush}" />
                <TextBlock x:Name="Percent" Text="0%" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="20"
                           HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.AutomationId="SplashPercent" />
            </Grid>

            <Grid Grid.Row="2" Height="22" ClipToBounds="True">
                <TextBlock x:Name="StepText" HorizontalAlignment="Center" Style="{StaticResource Muted}" FontSize="13" AutomationProperties.AutomationId="SplashStep">
                    <TextBlock.RenderTransform><TranslateTransform x:Name="StepShift" /></TextBlock.RenderTransform>
                </TextBlock>
            </Grid>
        </Grid>
    </Border>
</Window>

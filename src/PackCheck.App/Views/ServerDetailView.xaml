<UserControl x:Class="PackCheck.App.Views.ServerDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:PackCheck.App.Infrastructure"
             xmlns:c="clr-namespace:PackCheck.App.Controls"
             xmlns:v="clr-namespace:PackCheck.App.Views"
             AutomationProperties.AutomationId="ServerDetail">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis" />
        <l:NullToVisibility x:Key="NullVis" />
        <l:StatusBrush x:Key="StatusBrush" />
        <l:IndexToBool x:Key="IndexBool" />
        <l:IndexToVisibility x:Key="IndexVis" />

        <!-- Toggle chip used for console filters/options -->
        <Style x:Key="Chip" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource ConsoleMutedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" CornerRadius="6" Padding="10,5" Background="Transparent" BorderBrush="{DynamicResource ConsoleLineBrush}" BorderThickness="1">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ConsoleSelectBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource ConsoleTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ConsoleMutedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ConsoleButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource ConsoleTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6" Padding="10,5" Background="{DynamicResource ConsoleInputBrush}" BorderBrush="{DynamicResource ConsoleLineBrush}" BorderThickness="1">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ConsoleMutedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ConsoleInput" TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource ConsoleTextBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource ConsoleTextBrush}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{DynamicResource ConsoleInputBrush}" BorderBrush="{DynamicResource ConsoleLineBrush}" BorderThickness="1" CornerRadius="7">
                            <Grid>
                                <TextBlock x:Name="Hint" Text="{TemplateBinding Tag}" Foreground="{DynamicResource ConsoleMutedBrush}" FontFamily="{StaticResource UiFont}" FontSize="12.5"
                                           Margin="12,0" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" />
                                <ScrollViewer x:Name="PART_ContentHost" Margin="10,8" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Hint" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding StartCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,6,0" Visibility="{Binding IsBusy, Converter={x:Static l:Inverse.Visibility}}" AutomationProperties.AutomationId="StartServer">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconPlay}" Style="{StaticResource IconPath}" Width="11" Height="11" Fill="{DynamicResource OnPrimaryBrush}" Stroke="{DynamicResource OnPrimaryBrush}" />
                        <TextBlock Text="{l:Loc Servers_Start}" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding StopCommand}" Margin="0,0,6,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}" AutomationProperties.AutomationId="StopServer">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconStop}" Style="{StaticResource IconPath}" Width="10" Height="10" Fill="{DynamicResource TextBrush}" Stroke="{DynamicResource TextBrush}" />
                        <TextBlock Text="{l:Loc Servers_Stop}" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding RestartCommand}" Content="{l:Loc Servers_Restart}" Margin="0,0,6,0" Visibility="{Binding IsRunning, Converter={StaticResource BoolVis}}" />
                <Button Command="{Binding KillCommand}" Content="{l:Loc Servers_Kill}" Style="{StaticResource DangerButton}" Margin="0,0,6,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}" />
                <Button Command="{Binding ValidateServerCommand}" Content="{l:Loc Servers_Validate}" Margin="0,0,6,0" />
                <Button Command="{Binding OpenFolderCommand}" Style="{StaticResource GhostButton}" ToolTip="{l:Loc Common_OpenFolder}" AutomationProperties.Name="{l:Loc Common_OpenFolder}">
                    <Path Data="{StaticResource IconFolder}" Style="{StaticResource IconPath}" Stroke="{DynamicResource TextMutedBrush}" />
                </Button>
                <Button Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl, AncestorLevel=2}}" CommandParameter="{Binding}" Style="{StaticResource GhostButton}"
                        ToolTip="{l:Loc Delete_Button}" AutomationProperties.Name="{l:Loc Delete_Button}" AutomationProperties.AutomationId="DeleteServer" Margin="4,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconClose}" Style="{StaticResource IconPath}" Width="11" Stroke="{DynamicResource FailBrush}" />
                        <TextBlock Text="{l:Loc Delete_Button}" Foreground="{DynamicResource FailBrush}" Margin="6,0,0,0" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Border Width="32" Height="32" CornerRadius="6" Margin="0,0,10,0" ClipToBounds="True" Visibility="{Binding HasIcon, Converter={StaticResource BoolVis}}">
                    <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                </Border>
                <TextBlock Text="{Binding Name}" Style="{StaticResource H2}" FontSize="22" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </StackPanel>
        </DockPanel>

        <!-- Tabs -->
        <StackPanel Grid.Row="1" Margin="0,8,0,12">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <Border CornerRadius="5" Padding="8,2" Background="{DynamicResource Surface2Brush}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{Binding State, Converter={StaticResource StatusBrush}}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding StateText}" Margin="6,0,0,0" FontSize="12" FontWeight="SemiBold" Foreground="{Binding State, Converter={StaticResource StatusBrush}}" />
                        </StackPanel>
                    </Border>
                    <Border CornerRadius="5" Padding="8,2" Margin="6,0,0,0" Background="{DynamicResource Surface2Brush}">
                        <TextBlock Text="{Binding PlatformText}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                    </Border>
                    <Border CornerRadius="5" Padding="8,2" Margin="6,0,0,0" Background="{DynamicResource Surface2Brush}">
                        <TextBlock FontSize="12" Foreground="{DynamicResource TextMutedBrush}"><Run Text="localhost:" /><Run Text="{Binding Definition.Port, Mode=OneWay}" /></TextBlock>
                    </Border>
                </StackPanel>
        <StackPanel Orientation="Horizontal">
            <RadioButton Style="{StaticResource TabPill}" Content="{l:Loc Tab_Overview}" IsChecked="{Binding Tab, Converter={StaticResource IndexBool}, ConverterParameter=0}" AutomationProperties.AutomationId="TabOverview" />
            <RadioButton Style="{StaticResource TabPill}" Content="{l:Loc Servers_Console}" IsChecked="{Binding Tab, Converter={StaticResource IndexBool}, ConverterParameter=1}" AutomationProperties.AutomationId="TabConsole" />
            <RadioButton Style="{StaticResource TabPill}" Content="{l:Loc Servers_Properties}" IsChecked="{Binding Tab, Converter={StaticResource IndexBool}, ConverterParameter=2}" AutomationProperties.AutomationId="TabProperties" />
            <RadioButton Style="{StaticResource TabPill}" Content="{l:Loc Files_Tab}" IsChecked="{Binding Tab, Converter={StaticResource IndexBool}, ConverterParameter=5}" AutomationProperties.AutomationId="TabFiles" />
            <RadioButton Style="{StaticResource TabPill}" IsChecked="{Binding Tab, Converter={StaticResource IndexBool}, ConverterParameter=3}" Visibility="{Binding HasContentTab, Converter={StaticResource BoolVis}}">
                <TextBlock>
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="{l:Loc Nav_Plugins}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding UsesMods}" Value="True">
                                    <Setter Property="Text" Value="{l:Loc Nav_Mods}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </RadioButton>
            <RadioButton Style="{StaticResource TabPill}" Content="{l:Loc Servers_Backups}" IsChecked="{Binding Tab, Converter={StaticResource IndexBool}, ConverterParameter=4}" AutomationProperties.AutomationId="TabBackups" />
            <RadioButton Style="{StaticResource TabPill}" IsChecked="{Binding Tab, Converter={StaticResource IndexBool}, ConverterParameter=6}" AutomationProperties.AutomationId="TabAutomation">
                <TextBlock><Run Text="{l:Loc Auto_Tab}" /><Run Text="{Binding ActiveRuleCount, Mode=OneWay, StringFormat=' · {0}'}" /></TextBlock>
            </RadioButton>
            <RadioButton Style="{StaticResource TabPill}" Content="{l:Loc Identity_Tab}" IsChecked="{Binding Tab, Converter={StaticResource IndexBool}, ConverterParameter=7}" AutomationProperties.AutomationId="TabIdentity" />
        </StackPanel>
        </StackPanel>

        <!-- Crash banner -->
        <Border Grid.Row="2" VerticalAlignment="Top" Panel.ZIndex="2" Margin="0,0,0,0" Padding="14,10" CornerRadius="8" Background="{DynamicResource Surface2Brush}"
                BorderBrush="{DynamicResource FailBrush}" BorderThickness="1" Visibility="{Binding IsCrashed, Converter={StaticResource BoolVis}}" l:Anim.PopIn="True">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="{l:Loc Console_OpenLog}" Command="{Binding OpenLatestLogCommand}" Padding="10,5" />
                <Button DockPanel.Dock="Right" Content="{l:Loc Console_AskAi}" Command="{Binding AskAiCommand}" Padding="10,5" Margin="0,0,8,0"
                        AutomationProperties.AutomationId="CrashAskAi" />
                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="{Binding DiagnosisFixText}" Command="{Binding ApplyCrashFixCommand}" Padding="10,5" Margin="0,0,8,0"
                        Visibility="{Binding HasDiagnosisFix, Converter={StaticResource BoolVis}}" AutomationProperties.AutomationId="CrashFix" />
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource FailBrush}">
                        <Run Text="{l:Loc Console_Crashed}" /><Run Text="{Binding DiagnosisTitle, Mode=OneWay, StringFormat=' · {0}'}" />
                    </TextBlock>
                    <TextBlock Text="{Binding CrashSummary}" Style="{StaticResource Muted}" FontSize="12.5" TextTrimming="CharacterEllipsis" ToolTip="{Binding CrashSummary}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Overview -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Visibility="{Binding Tab, Converter={StaticResource IndexVis}, ConverterParameter=0}">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Gauges}" AutomationProperties.AutomationId="Gauges">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,12,12" Padding="14,16" ToolTip="{Binding UnavailableReason}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource Label}" Margin="0,0,0,10" HorizontalAlignment="Center" />
                                    <Grid Width="118" Height="118">
                                        <c:ProgressRing Value="{Binding Fraction}" Thickness="9" Track="{DynamicResource Surface3Brush}" Fill="{Binding Health, Converter={x:Static l:HealthBrush.Instance}}" />
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Text}" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="22" HorizontalAlignment="Center" />
                                            <TextBlock Text="{Binding Health, Converter={x:Static l:HealthText.Instance}}" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Center"
                                                       Foreground="{Binding Health, Converter={x:Static l:HealthBrush.Instance}}" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" FontSize="12" HorizontalAlignment="Center" Margin="0,10,0,0" TextTrimming="CharacterEllipsis" />
                                    <l:Sparkline Values="{Binding History}" Stroke="{Binding Health, Converter={x:Static l:HealthBrush.Instance}}" Height="26" Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <UniformGrid Columns="5">
                    <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,12,12">
                        <StackPanel>
                            <TextBlock Text="{l:Loc Card_Players}" Style="{StaticResource Label}" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding PlayersText}" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="20" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,12,12">
                        <StackPanel>
                            <TextBlock Text="{l:Loc Card_Uptime}" Style="{StaticResource Label}" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding Uptime}" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="20" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,12,12">
                        <StackPanel>
                            <TextBlock Text="{l:Loc Card_Disk}" Style="{StaticResource Label}" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding DiskText}" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="20" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,12,12">
                        <StackPanel>
                            <TextBlock Text="{l:Loc Card_World}" Style="{StaticResource Label}" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding WorldText}" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="20" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,12,12">
                        <StackPanel>
                            <TextBlock Text="{l:Loc Card_Java}" Style="{StaticResource Label}" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding JavaText}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Grid Margin="0,0,12,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <!-- resources -->
                    <Border Style="{StaticResource Card}" AutomationProperties.AutomationId="ServerResources">
                        <StackPanel>
                            <TextBlock Text="{l:Loc Res_Title}" Style="{StaticResource H2}" FontSize="15" />
                            <TextBlock Text="{l:Loc Res_Hint}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,10" />
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding EditRamText}" FontFamily="{StaticResource MonoFont}" FontSize="12" />
                                <TextBlock Text="{l:Loc Wizard_Ram}" FontWeight="SemiBold" />
                            </DockPanel>
                            <Slider Minimum="1" Maximum="{Binding MaxRamGb}" Value="{Binding EditRamGb}" IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,6,0,10"
                                    IsEnabled="{Binding CanEdit}" AutomationProperties.Name="{l:Loc Wizard_Ram}" />
                            <TextBlock Text="{Binding EditRamWarning}" Foreground="{DynamicResource WarnBrush}" FontSize="11.5" TextWrapping="Wrap" Margin="0,-6,0,8"
                                       Visibility="{Binding EditRamWarning, Converter={StaticResource NullVis}}" />
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding EditCoresText}" FontFamily="{StaticResource MonoFont}" FontSize="12" />
                                <TextBlock Text="{l:Loc Wizard_Cpu}" FontWeight="SemiBold" />
                            </DockPanel>
                            <Slider Minimum="1" Maximum="{Binding MaxCores}" Value="{Binding EditCores}" IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,6,0,10"
                                    IsEnabled="{Binding CanEdit}" AutomationProperties.Name="{l:Loc Wizard_Cpu}" />
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding EditAikar}" IsEnabled="{Binding CanEdit}">
                                <StackPanel>
                                    <TextBlock Text="{l:Loc Res_Aikar}" />
                                    <TextBlock Text="{l:Loc Res_AikarHint}" Style="{StaticResource Muted}" FontSize="11.5" TextWrapping="Wrap" />
                                </StackPanel>
                            </CheckBox>
                            <DockPanel Margin="0,12,0,0">
                                <Button DockPanel.Dock="Right" Content="{l:Loc Common_Save}" Style="{StaticResource PrimaryButton}" Command="{Binding SaveResourcesCommand}"
                                        IsEnabled="{Binding ResourcesChanged}" AutomationProperties.AutomationId="SaveResources" />
                                <TextBlock Text="{l:Loc Res_StopToEdit}" Style="{StaticResource Muted}" FontSize="11.5" VerticalAlignment="Center" TextWrapping="Wrap"
                                           Visibility="{Binding CanEdit, Converter={x:Static l:Inverse.Visibility}}" />
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- technical details -->
                    <Border Grid.Column="2" Style="{StaticResource Card}" AutomationProperties.AutomationId="ServerTechnical">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="{l:Loc About_Copy}" Command="{Binding CopyTechnicalCommand}" Padding="8,3" />
                                <TextBlock Text="{l:Loc Tech_Title}" Style="{StaticResource H2}" FontSize="15" />
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding TechnicalInfo}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Key}" Style="{StaticResource Muted}" FontSize="12" />
                                            <TextBlock Grid.Column="1" Text="{Binding Value}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding ProcessText}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Foreground="{DynamicResource PassBrush}" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Visibility="{Binding IsRunning, Converter={StaticResource BoolVis}}" />
                            <TextBlock Text="{l:Loc Tech_Command}" Style="{StaticResource Label}" Margin="0,10,0,4" />
                            <Border Background="{DynamicResource ConsoleBgBrush}" CornerRadius="6" Padding="10,8">
                                <TextBox Text="{Binding JvmCommand, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource ConsoleTextBrush}"
                                         FontFamily="{StaticResource MonoFont}" FontSize="11" TextWrapping="Wrap" MaxHeight="90" VerticalScrollBarVisibility="Auto" Padding="0" MinHeight="0" />
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="{l:Loc Console_Players}" Style="{StaticResource H2}" FontSize="15" />
                        <TextBlock Text="{l:Loc Console_NoPlayers}" Style="{StaticResource Muted}" Margin="0,8,0,0" Visibility="{Binding Players.Count, Converter={x:Static l:Inverse.Visibility}}" />
                        <ItemsControl ItemsSource="{Binding Players}" Margin="0,8,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="6" Padding="10,5" Margin="0,0,6,6" Background="{DynamicResource Surface2Brush}">
                                        <TextBlock Text="{Binding}" FontWeight="SemiBold" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Console -->
        <Grid Grid.Row="2" Visibility="{Binding Tab, Converter={StaticResource IndexVis}, ConverterParameter=1}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="190" />
            </Grid.ColumnDefinitions>
            <Border CornerRadius="10" Background="{DynamicResource ConsoleBgBrush}" BorderBrush="{DynamicResource ConsoleLineBrush}" BorderThickness="1" AutomationProperties.AutomationId="ConsolePanel">
                <DockPanel>
                    <!-- toolbar -->
                    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource ConsoleLineBrush}" BorderThickness="0,0,0,1" Padding="10,8">
                        <StackPanel>
                            <WrapPanel>
                                <ToggleButton Style="{StaticResource Chip}" IsChecked="{Binding ShowInfo}">
                                    <TextBlock><Run Text="INFO " /><Run Text="{Binding InfoCount, Mode=OneWay}" /></TextBlock>
                                </ToggleButton>
                                <ToggleButton Style="{StaticResource Chip}" IsChecked="{Binding ShowWarn}">
                                    <TextBlock Foreground="{DynamicResource ConsoleWarnBrush}"><Run Text="WARN " /><Run Text="{Binding WarnCount, Mode=OneWay}" /></TextBlock>
                                </ToggleButton>
                                <ToggleButton Style="{StaticResource Chip}" IsChecked="{Binding ShowError}">
                                    <TextBlock Foreground="{DynamicResource ConsoleErrorBrush}"><Run Text="ERROR " /><Run Text="{Binding ErrorCount, Mode=OneWay}" /></TextBlock>
                                </ToggleButton>
                                <Rectangle Width="1" Height="18" Margin="4,0,10,0" Fill="{DynamicResource ConsoleLineBrush}" />
                                <ToggleButton Style="{StaticResource Chip}" IsChecked="{Binding ShowTimestamps}" Content="{l:Loc Console_Time}" />
                                <ToggleButton Style="{StaticResource Chip}" IsChecked="{Binding Wrap}" Content="{l:Loc Console_Wrap}" />
                                <ToggleButton Style="{StaticResource Chip}" IsChecked="{Binding Paused}" Content="{l:Loc Console_Pause}" />
                            </WrapPanel>
                            <DockPanel Margin="0,8,0,0">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                                    <Button Style="{StaticResource ConsoleButton}" Command="{Binding CopyConsoleCommand}" Content="{l:Loc Console_Copy}" />
                                    <Button Style="{StaticResource ConsoleButton}" Command="{Binding SaveLogCommand}" Content="{l:Loc Console_Save}" />
                                    <Button Style="{StaticResource ConsoleButton}" Command="{Binding ClearConsoleCommand}" Content="{l:Loc Console_Clear}" Margin="0" />
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0" Visibility="{Binding MatchPosition, Converter={StaticResource NullVis}}">
                                    <TextBlock VerticalAlignment="Center" FontSize="12" Margin="0,0,8,0" Foreground="{DynamicResource ConsoleMutedBrush}" Text="{Binding MatchPosition}"
                                               AutomationProperties.AutomationId="ConsoleMatchPosition" />
                                    <Button Style="{StaticResource ConsoleButton}" Content="↑" ToolTip="{l:Loc Console_PrevMatch}" Command="{Binding PreviousMatchCommand}" AutomationProperties.Name="{l:Loc Console_PrevMatch}" />
                                    <Button Style="{StaticResource ConsoleButton}" Content="↓" ToolTip="{l:Loc Console_NextMatch}" Command="{Binding NextMatchCommand}" AutomationProperties.Name="{l:Loc Console_NextMatch}" />
                                    <ToggleButton Style="{StaticResource Chip}" IsChecked="{Binding FilterSearch}" Content="{l:Loc Console_FilterOnly}" Margin="0" />
                                </StackPanel>
                                <TextBox x:Name="SearchBox" PreviewKeyDown="OnSearchKey" Height="32" Style="{StaticResource ConsoleInput}" Tag="{l:Loc Console_Search}" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                                         AutomationProperties.Name="{l:Loc Console_Search}" />
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- input -->
                    <Grid DockPanel.Dock="Bottom" Margin="10">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="{l:Loc Console_Send}" Command="{Binding SendCommand}" Margin="8,0,0,0" AutomationProperties.AutomationId="ConsoleSend" />
                            <TextBox x:Name="CommandBox" Height="38" Style="{StaticResource ConsoleInput}" Tag="{l:Loc Console_CommandHint}" Text="{Binding Command, UpdateSourceTrigger=PropertyChanged}"
                                     PreviewKeyDown="OnCommandKey" AutomationProperties.Name="{l:Loc Console_CommandHint}" AutomationProperties.AutomationId="ConsoleInput" />
                        </DockPanel>
                        <Popup IsOpen="{Binding Suggestions.Count, Mode=OneWay, Converter={x:Static l:CountToBool.Instance}}" PlacementTarget="{Binding ElementName=CommandBox}" Placement="Top"
                               AllowsTransparency="True" StaysOpen="True">
                            <Border Background="{DynamicResource ConsoleInputBrush}" BorderBrush="{DynamicResource ConsoleLineBrush}" BorderThickness="1" CornerRadius="7" Padding="4" Margin="0,0,0,4">
                                <ItemsControl ItemsSource="{Binding Suggestions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource ConsoleButton}" Margin="0,1" HorizontalContentAlignment="Left" Content="{Binding}"
                                                    Command="{Binding DataContext.AcceptSuggestionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </Popup>
                    </Grid>

                    <!-- output -->
                    <Grid>
                        <TextBlock Text="{l:Loc Console_Empty}" Foreground="{DynamicResource ConsoleMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding Console.Count, Converter={x:Static l:Inverse.Visibility}}" />
                        <ListBox x:Name="Output" ItemsSource="{Binding Console}" Background="Transparent" BorderThickness="0" Padding="10,8,4,0"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                                 SelectionMode="Extended" AutomationProperties.AutomationId="ConsoleOutput">
                            <ListBox.Style>
                                <Style TargetType="ListBox">
                                    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Wrap}" Value="False">
                                            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.Style>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Bd" Background="Transparent" Padding="2,1"><ContentPresenter /></Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ConsoleSelectBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Time}" Width="64" FontFamily="{StaticResource MonoFont}" FontSize="12.5" Foreground="{DynamicResource ConsoleMutedBrush}"
                                                   Visibility="{Binding DataContext.ShowTimestamps, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BoolVis}}" />
                                        <TextBlock l:ConsoleText.Text="{Binding Message}" FontFamily="{StaticResource MonoFont}"
                                                   l:ConsoleText.Search="{Binding DataContext.Search, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                   l:ConsoleText.Players="{Binding DataContext.KnownPlayers, RelativeSource={RelativeSource AncestorType=ListBox}}" FontSize="12.5" Foreground="{Binding Level, Converter={x:Static l:ConsoleBrush.Instance}}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="TextWrapping" Value="Wrap" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DataContext.Wrap, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="False">
                                                            <Setter Property="TextWrapping" Value="NoWrap" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- side panel: quick actions + players -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Card}" Padding="12">
                        <StackPanel>
                            <TextBlock Text="{l:Loc Console_Quick}" Style="{StaticResource Label}" Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding QuickCommands}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding}" Command="{Binding DataContext.QuickCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" FontFamily="{StaticResource MonoFont}" FontSize="12" FontWeight="Normal" Padding="8,5" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="12" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Label}" Margin="0,0,0,8"><Run Text="{l:Loc Console_Players}" /><Run Text=" · " /><Run Text="{Binding PlayersText, Mode=OneWay}" /></TextBlock>
                            <TextBlock Text="{l:Loc Console_NoPlayers}" Style="{StaticResource Muted}" FontSize="12" Visibility="{Binding Players.Count, Converter={x:Static l:Inverse.Visibility}}" />
                            <ItemsControl ItemsSource="{Binding Players}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Padding="8,5" Content="{Binding}" Click="OnPlayerClick" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Automation -->
        <Grid Grid.Row="2" Visibility="{Binding Tab, Converter={StaticResource IndexVis}, ConverterParameter=6}" AutomationProperties.AutomationId="AutomationPage">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <TextBlock Text="{l:Loc Auto_Title}" Style="{StaticResource H2}" FontSize="17" />
                    <TextBlock Text="{l:Loc Auto_Subtitle}" Style="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <ComboBox x:Name="AddRuleBox" Width="260" ItemsSource="{Binding AutomationKinds}" SelectionChanged="OnAddRule" VerticalAlignment="Center"
                                  ToolTip="{l:Loc Auto_Add}" AutomationProperties.Name="{l:Loc Auto_Add}" AutomationProperties.AutomationId="AddRule">
                            <ComboBox.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding Converter={x:Static l:LocKey.Prefixed}, ConverterParameter=Auto_}" /></DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="{l:Loc Auto_Add}" VerticalAlignment="Center" Margin="10,0,0,0" Style="{StaticResource Muted}" IsHitTestVisible="False" />
                        <Button Content="{l:Loc Auto_Recommended}" Command="{Binding AddRecommendedCommand}" Margin="16,0,0,0" VerticalAlignment="Center" ToolTip="{l:Loc Auto_RecommendedHint}"
                                AutomationProperties.AutomationId="AddRecommended" />
                    </StackPanel>
                </StackPanel>
                <Grid>
                    <Border Style="{StaticResource Card}" Padding="28" Visibility="{Binding AutomationRules.Count, Converter={x:Static l:Inverse.Visibility}}" VerticalAlignment="Top">
                        <TextBlock Text="{l:Loc Auto_Empty}" Style="{StaticResource Muted}" TextWrapping="Wrap" />
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding AutomationRules}" AutomationProperties.AutomationId="AutomationRules">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,10">
                                        <StackPanel>
                                            <DockPanel>
                                                <CheckBox DockPanel.Dock="Left" Style="{StaticResource Switch}" IsChecked="{Binding Enabled}" VerticalAlignment="Top" Margin="0,2,12,0" AutomationProperties.Name="{Binding Title}" />
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                                    <Button Style="{StaticResource GhostButton}" Content="{l:Loc Auto_RunNow}" Padding="8,3"
                                                            Command="{Binding DataContext.RunRuleNowCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                                    <Button Style="{StaticResource GhostButton}" Padding="8,3" ToolTip="{l:Loc Auto_Remove}" AutomationProperties.Name="{l:Loc Auto_Remove}"
                                                            Command="{Binding DataContext.RemoveRuleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                                        <Path Data="{StaticResource IconClose}" Style="{StaticResource IconPath}" Width="10" Height="10" Stroke="{DynamicResource FailBrush}" />
                                                    </Button>
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" />
                                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DockPanel>

                                            <WrapPanel Margin="46,10,0,0" Visibility="{Binding IsTrigger, Converter={StaticResource BoolVis}}">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,12,8" Visibility="{Binding HasSource, Converter={StaticResource BoolVis}}">
                                                    <TextBlock Text="{l:Loc Auto_When}" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource Muted}" />
                                                    <ComboBox ItemsSource="{Binding SourceChoices}" SelectedItem="{Binding SourceServer}" Width="170" AutomationProperties.Name="{l:Loc Auto_When}" />
                                                    <ComboBox ItemsSource="{Binding Events}" SelectedItem="{Binding SourceEvent}" Width="130" Margin="6,0,0,0">
                                                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={x:Static l:LocKey.Prefixed}, ConverterParameter=Event_}" /></DataTemplate></ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,12,8">
                                                    <TextBlock Text="{l:Loc Auto_Then}" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource Muted}" />
                                                    <ComboBox ItemsSource="{Binding Actions}" SelectedItem="{Binding Action}" Width="190" AutomationProperties.Name="{l:Loc Auto_Then}">
                                                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={x:Static l:LocKey.Prefixed}, ConverterParameter=Act_}" /></DataTemplate></ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,12,8">
                                                    <TextBlock Text="{l:Loc Auto_After}" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource Muted}" />
                                                    <TextBox Text="{Binding DelaySeconds, UpdateSourceTrigger=PropertyChanged, Delay=400}" Width="78" Height="34" Padding="8,4" MinHeight="0" VerticalContentAlignment="Center" />
                                                    <TextBlock Text="{l:Loc Auto_Seconds}" VerticalAlignment="Center" Margin="6,0,0,0" Style="{StaticResource Muted}" />
                                                </StackPanel>
                                            </WrapPanel>

                                            <WrapPanel Margin="46,10,0,0">
                                                <CheckBox Content="{l:Loc Auto_AtTime}" IsChecked="{Binding UseTime}" Visibility="{Binding CanUseInterval, Converter={StaticResource BoolVis}}" VerticalAlignment="Center" Margin="0,0,14,8" />
                                                <StackPanel Orientation="Horizontal" Margin="0,0,16,8" Visibility="{Binding HasTime, Converter={StaticResource BoolVis}}">
                                                    <TextBlock Text="{l:Loc Auto_Time}" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource Muted}" />
                                                    <TextBox Text="{Binding At, UpdateSourceTrigger=PropertyChanged, Delay=400}" Width="84" Height="34" Padding="8,4" MinHeight="0" VerticalContentAlignment="Center" FontFamily="{StaticResource MonoFont}" AutomationProperties.Name="{l:Loc Auto_Time}">
                                                        <TextBox.Style>
                                                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding TimeValid}" Value="False"><Setter Property="BorderBrush" Value="{DynamicResource FailBrush}" /></DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBox.Style>
                                                    </TextBox>
                                                </StackPanel>
                                                <ItemsControl ItemsSource="{Binding Days}" Margin="0,0,16,8" Visibility="{Binding HasTime, Converter={StaticResource BoolVis}}" ToolTip="{l:Loc Auto_DaysHint}">
                                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate><ToggleButton Style="{StaticResource Chip}" IsChecked="{Binding On}" Content="{Binding Label}" Margin="0,0,4,0" /></DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,16,8" Visibility="{Binding HasInterval, Converter={StaticResource BoolVis}}">
                                                    <TextBlock Text="{l:Loc Auto_Every}" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource Muted}" />
                                                    <TextBox Text="{Binding IntervalMinutes, UpdateSourceTrigger=PropertyChanged, Delay=400}" Width="78" Height="34" Padding="8,4" MinHeight="0" VerticalContentAlignment="Center" />
                                                    <TextBlock Text="{l:Loc Auto_Minutes}" VerticalAlignment="Center" Margin="6,0,0,0" Style="{StaticResource Muted}" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,16,8" Visibility="{Binding HasThreshold, Converter={StaticResource BoolVis}}">
                                                    <TextBlock Text="{Binding ThresholdLabel}" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource Muted}" />
                                                    <TextBox Text="{Binding Threshold, UpdateSourceTrigger=PropertyChanged, Delay=400}" Width="78" Height="34" Padding="8,4" MinHeight="0" VerticalContentAlignment="Center" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,16,8" Visibility="{Binding HasDuration, Converter={StaticResource BoolVis}}">
                                                    <TextBlock Text="{l:Loc Auto_For}" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource Muted}" />
                                                    <TextBox Text="{Binding ForMinutes, UpdateSourceTrigger=PropertyChanged, Delay=400}" Width="78" Height="34" Padding="8,4" MinHeight="0" VerticalContentAlignment="Center" />
                                                    <TextBlock Text="{l:Loc Auto_Minutes}" VerticalAlignment="Center" Margin="6,0,0,0" Style="{StaticResource Muted}" />
                                                </StackPanel>
                                                <CheckBox Content="{l:Loc Auto_RestartReaction}" IsChecked="{Binding Restart}" Visibility="{Binding HasReaction, Converter={StaticResource BoolVis}}" VerticalAlignment="Center" Margin="0,0,16,8" />
                                                <StackPanel Orientation="Horizontal" Margin="0,0,16,8" Visibility="{Binding HasRetries, Converter={StaticResource BoolVis}}">
                                                    <TextBlock Text="{l:Loc Auto_MaxRetries}" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource Muted}" />
                                                    <TextBox Text="{Binding MaxRetries, UpdateSourceTrigger=PropertyChanged, Delay=400}" Width="78" Height="34" Padding="8,4" MinHeight="0" VerticalContentAlignment="Center" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,16,8" Visibility="{Binding HasWarning, Converter={StaticResource BoolVis}}">
                                                    <TextBlock Text="{l:Loc Auto_Warning}" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource Muted}" />
                                                    <TextBox Text="{Binding WarningSeconds, UpdateSourceTrigger=PropertyChanged, Delay=400}" Width="78" Height="34" Padding="8,4" MinHeight="0" VerticalContentAlignment="Center" />
                                                    <TextBlock Text="{l:Loc Auto_Seconds}" VerticalAlignment="Center" Margin="6,0,0,0" Style="{StaticResource Muted}" />
                                                </StackPanel>
                                            </WrapPanel>
                                            <DockPanel Margin="46,0,0,8" Visibility="{Binding ShowsCommand, Converter={StaticResource BoolVis}}">
                                                <TextBlock Text="/" FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center" Margin="0,0,4,0" Style="{StaticResource Muted}" />
                                                <TextBox Text="{Binding Command, UpdateSourceTrigger=PropertyChanged, Delay=400}" FontFamily="{StaticResource MonoFont}" Tag="{l:Loc Auto_CommandHint}" />
                                            </DockPanel>
                                            <TextBox Text="{Binding Message, UpdateSourceTrigger=PropertyChanged, Delay=400}" Margin="46,0,0,8" Tag="{l:Loc Auto_MessageHint}"
                                                     Visibility="{Binding ShowsMessage, Converter={StaticResource BoolVis}}" />
                                            <TextBlock Margin="46,0,0,0" FontSize="11.5" Style="{StaticResource Muted}" TextWrapping="Wrap">
                                                <Run Text="{Binding NextRun, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding LastRun, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </DockPanel>

            <!-- event log -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="{l:Loc Auto_ClearLog}" Command="{Binding ClearAutomationLogCommand}" Padding="6,2" />
                        <TextBlock Text="{l:Loc Auto_Log}" Style="{StaticResource H2}" FontSize="15" />
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{l:Loc Auto_LogEmpty}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"
                               Visibility="{Binding AutomationEvents.Count, Converter={x:Static l:Inverse.Visibility}}" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding AutomationEvents}" AutomationProperties.AutomationId="AutomationLog">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,0,8">
                                        <Ellipse DockPanel.Dock="Left" Width="7" Height="7" Margin="0,6,8,0" VerticalAlignment="Top">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{DynamicResource PassBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Ok}" Value="False"><Setter Property="Fill" Value="{DynamicResource FailBrush}" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <StackPanel>
                                            <TextBlock FontSize="12"><Run Text="{Binding Rule, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding Time, Mode=OneWay}" Foreground="{DynamicResource TextMutedBrush}" /></TextBlock>
                                            <TextBlock Text="{Binding Text}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Files -->
        <ContentControl Grid.Row="2" Visibility="{Binding Tab, Converter={StaticResource IndexVis}, ConverterParameter=5}" Content="{Binding Files}">
            <ContentControl.Style>
                <Style TargetType="ContentControl">
                    <Setter Property="ContentTemplate">
                        <Setter.Value>
                            <DataTemplate><v:FilesView /></DataTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Tab}" Value="0"><Setter Property="Content" Value="{x:Null}" /></DataTrigger>
                        <DataTrigger Binding="{Binding Tab}" Value="1"><Setter Property="Content" Value="{x:Null}" /></DataTrigger>
                        <DataTrigger Binding="{Binding Tab}" Value="2"><Setter Property="Content" Value="{x:Null}" /></DataTrigger>
                        <DataTrigger Binding="{Binding Tab}" Value="3"><Setter Property="Content" Value="{x:Null}" /></DataTrigger>
                        <DataTrigger Binding="{Binding Tab}" Value="4"><Setter Property="Content" Value="{x:Null}" /></DataTrigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
        </ContentControl>

        <!-- Properties -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0" Visibility="{Binding Tab, Converter={StaticResource IndexVis}, ConverterParameter=2}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="14,12">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <CheckBox Content="{l:Loc Props_OnlyModified}" IsChecked="{Binding PropertyOnlyModified}" VerticalAlignment="Center" Margin="12,0,0,0" AutomationProperties.AutomationId="PropsOnlyModified" />
                        <Button Content="{l:Loc Props_Raw}" Command="{Binding EditRawPropertiesCommand}" Margin="8,0,8,0" />
                        <Button Content="{l:Loc Common_Save}" Style="{StaticResource PrimaryButton}" Command="{Binding SavePropertiesCommand}" AutomationProperties.AutomationId="SaveProperties" />
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="12" Foreground="{DynamicResource WarnBrush}"
                               Text="{Binding ChangedCount, Converter={x:Static l:FormatKey.Instance}, ConverterParameter=Props_Modified}" Visibility="{Binding ChangedCount, Converter={StaticResource NullVis}}" />
                    <TextBox Tag="{l:Loc Props_Search}" Text="{Binding PropertySearch, UpdateSourceTrigger=PropertyChanged, Delay=150}" ToolTip="{l:Loc Props_Search}" AutomationProperties.Name="{l:Loc Props_Search}" AutomationProperties.AutomationId="PropsSearch" />
                </DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{l:Loc Servers_SaveWhileRunning}" Foreground="{DynamicResource WarnBrush}" Margin="14,0,14,8" Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}" />
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,0,14,14">
                    <ItemsControl ItemsSource="{Binding PropertyGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,4,0,10">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource H2}" FontSize="14" Margin="0,6,0,6" />
                                    <ItemsControl ItemsSource="{Binding Rows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition />
                                                            <ColumnDefinition Width="260" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Margin="0,0,16,0">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding DisplayKey}" FontFamily="{StaticResource MonoFont}" FontSize="12.5" FontWeight="SemiBold" />
                                                                <Ellipse Width="7" Height="7" Margin="8,0,0,0" Fill="{DynamicResource WarnBrush}" VerticalAlignment="Center" Visibility="{Binding IsChanged, Converter={StaticResource BoolVis}}" />
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" FontSize="12" Visibility="{Binding Description, Converter={StaticResource NullVis}}" />
                                                            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource FailBrush}" FontSize="12" Visibility="{Binding Error, Converter={StaticResource NullVis}}" />
                                                        </StackPanel>
                                                        <ContentControl Grid.Column="1" Content="{Binding}" VerticalAlignment="Center" Focusable="False">
                                                            <ContentControl.Style>
                                                                <Style TargetType="ContentControl">
                                                                    <Setter Property="ContentTemplate">
                                                                        <Setter.Value>
                                                                            <DataTemplate>
                                                                                <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}" Padding="8,5" AutomationProperties.Name="{Binding Key}" />
                                                                            </DataTemplate>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Kind}" Value="Bool">
                                                                            <Setter Property="ContentTemplate">
                                                                                <Setter.Value>
                                                                                    <DataTemplate>
                                                                                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding BoolValue}" HorizontalAlignment="Left" AutomationProperties.Name="{Binding Key}" />
                                                                                    </DataTemplate>
                                                                                </Setter.Value>
                                                                            </Setter>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Kind}" Value="Choice">
                                                                            <Setter Property="ContentTemplate">
                                                                                <Setter.Value>
                                                                                    <DataTemplate>
                                                                                        <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Value}" AutomationProperties.Name="{Binding Key}">
                                                                                            <ComboBox.ItemTemplate>
                                                                                                <DataTemplate><TextBlock Text="{Binding}" /></DataTemplate>
                                                                                            </ComboBox.ItemTemplate>
                                                                                        </ComboBox>
                                                                                    </DataTemplate>
                                                                                </Setter.Value>
                                                                            </Setter>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsSecret}" Value="True">
                                                                            <Setter Property="ContentTemplate">
                                                                                <Setter.Value>
                                                                                    <DataTemplate>
                                                                                        <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}" Padding="8,5" Foreground="Transparent" CaretBrush="{DynamicResource TextBrush}"
                                                                                                 ToolTip="•••••" AutomationProperties.Name="{Binding Key}" />
                                                                                    </DataTemplate>
                                                                                </Setter.Value>
                                                                            </Setter>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ContentControl.Style>
                                                        </ContentControl>
                                                        <Button Grid.Column="2" Content="↺" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Padding="8,4" ToolTip="{Binding DefaultText}"
                                                                Command="{Binding ResetCommand}" Visibility="{Binding IsDefault, Converter={x:Static l:Inverse.Visibility}}" AutomationProperties.Name="{l:Loc Props_Reset}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Plugins / mods -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Visibility="{Binding Tab, Converter={StaticResource IndexVis}, ConverterParameter=3}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <Button DockPanel.Dock="Right" Content="{l:Loc Plugins_AddFile}" Command="{Binding AddPluginFileCommand}" />
                    <TextBlock Text="{l:Loc Plugins_Installed_List}" Style="{StaticResource H2}" FontSize="15" VerticalAlignment="Center" />
                </DockPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding PluginList}" l:Anim.Stagger="True">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,9">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Command="{Binding DataContext.TogglePluginCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Padding="12,6">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource BaseButton}">
                                                    <Setter Property="Content" Value="{l:Loc Plugins_Disable}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                            <Setter Property="Content" Value="{l:Loc Plugins_Enable}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold">
                                                <Run Text="{Binding Name, Mode=OneWay, TargetNullValue='?'}" />
                                                <Run Text="{Binding Version, Mode=OneWay}" Foreground="{DynamicResource TextMutedBrush}" FontWeight="Normal" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding File}" Style="{StaticResource Muted}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Backups -->
        <Grid Grid.Row="2" Visibility="{Binding Tab, Converter={StaticResource IndexVis}, ConverterParameter=4}" AutomationProperties.AutomationId="BackupsPage">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <!-- Backup list -->
            <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="{l:Loc Common_OpenFolder}" Command="{Binding OpenBackupFolderCommand}" />
                            <TextBlock VerticalAlignment="Center">
                                <Run Text="{l:Loc Servers_Backups}" FontSize="15" FontWeight="SemiBold" />
                                <Run Text="{Binding BackupList.Count, Mode=OneWay, StringFormat=' · {0}'}" Foreground="{DynamicResource TextMutedBrush}" />
                                <Run Text=" · " Foreground="{DynamicResource TextMutedBrush}" /><Run Text="{Binding BackupTotalSize, Mode=OneWay, Converter={x:Static l:Bytes.Instance}}" Foreground="{DynamicResource TextMutedBrush}" />
                            </TextBlock>
                        </DockPanel>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding BackupKindNames}" SelectedIndex="{Binding BackupKindIndex}" AutomationProperties.Name="{l:Loc Backups_Kind}" AutomationProperties.AutomationId="BackupKind" />
                            <TextBox Grid.Column="1" Margin="8,0" Tag="{l:Loc Backups_NoteHint}" Text="{Binding BackupNote, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{l:Loc Backups_NoteHint}" AutomationProperties.AutomationId="BackupNote" />
                            <Button Grid.Column="2" Content="{l:Loc Backups_Create}" Style="{StaticResource PrimaryButton}" Command="{Binding CreateBackupCommand}" IsEnabled="{Binding IsNotBackingUp}" AutomationProperties.AutomationId="CreateBackup" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding IsBackingUp, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="{l:Loc Backups_Working}" Style="{StaticResource Muted}" />
                        </StackPanel>
                    </StackPanel>
                    <Grid>
                        <TextBlock Text="{l:Loc Backups_Empty}" Style="{StaticResource Muted}" Visibility="{Binding BackupList.Count, Converter={x:Static l:Inverse.Visibility}}" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding BackupList}" AutomationProperties.AutomationId="BackupList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Style="{StaticResource GhostButton}" Padding="8,6" ToolTip="{l:Loc Backups_Pin}" AutomationProperties.Name="{l:Loc Backups_Pin}"
                                                            Command="{Binding DataContext.TogglePinCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                                        <TextBlock x:Name="Pin" Text="☆" FontSize="15" Foreground="{DynamicResource TextMutedBrush}" />
                                                    </Button>
                                                    <Button Content="{l:Loc Backups_Contents}" Padding="10,6" Margin="4,0,0,0"
                                                            Command="{Binding DataContext.InspectBackupCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                                    <Button Content="{l:Loc Backups_Restore}" Padding="10,6" Margin="6,0,0,0"
                                                            Command="{Binding DataContext.RestoreBackupCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                                    <Button Style="{StaticResource GhostButton}" Padding="10,6" Margin="6,0,0,0" ToolTip="{l:Loc Backups_Delete}" AutomationProperties.Name="{l:Loc Backups_Delete}"
                                                            Command="{Binding DataContext.DeleteBackupCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                                        <TextBlock Text="{l:Loc Backups_Delete}" Foreground="{DynamicResource FailBrush}" />
                                                    </Button>
                                                </StackPanel>
                                                <StackPanel VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border CornerRadius="4" Padding="6,1" Background="{DynamicResource Surface2Brush}" Margin="0,0,8,0">
                                                            <TextBlock x:Name="KindText" Text="{l:Loc BackupKind_Full}" FontSize="11" FontWeight="SemiBold" />
                                                        </Border>
                                                        <TextBlock Text="{Binding CreatedAt.LocalDateTime, Mode=OneWay, StringFormat=g}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding Size, Mode=OneWay, Converter={x:Static l:Bytes.Instance}}" Foreground="{DynamicResource TextMutedBrush}" Margin="8,0,0,0" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Note}" Style="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" Visibility="{Binding Note, Converter={StaticResource NullVis}}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Pinned}" Value="True">
                                                <Setter TargetName="Pin" Property="Text" Value="★" />
                                                <Setter TargetName="Pin" Property="Foreground" Value="{DynamicResource WarnBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="Worlds"><Setter TargetName="KindText" Property="Text" Value="{l:Loc BackupKind_Worlds}" /></DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="Config"><Setter TargetName="KindText" Property="Text" Value="{l:Loc BackupKind_Config}" /></DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- Side: contents of the selected backup, or retention settings -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12" Visibility="{Binding HasBackupContents, Converter={StaticResource BoolVis}}" AutomationProperties.AutomationId="BackupContents">
                        <StackPanel>
                            <TextBlock Text="{l:Loc Backups_Contents}" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="{l:Loc Backups_ContentsHint}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,10" />
                            <ItemsControl ItemsSource="{Binding BackupContents}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,3">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Size, Converter={x:Static l:Bytes.Instance}}" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" />
                                            <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center">
                                                <TextBlock>
                                                    <Run Text="{Binding Name, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" />
                                                </TextBlock>
                                            </CheckBox>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="{l:Loc Backups_RestoreSelected}" Style="{StaticResource PrimaryButton}" Command="{Binding RestoreSelectedCommand}" Margin="0,12,0,0" HorizontalAlignment="Left" AutomationProperties.AutomationId="RestoreSelected" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{l:Loc Backups_Retention}" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="{l:Loc Backups_RetentionHint}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,10" />
                            <DockPanel Margin="0,0,0,6">
                                <TextBox DockPanel.Dock="Right" Width="70" Text="{Binding BackupKeepLast, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="{l:Loc Backups_KeepLast}" />
                                <TextBlock Text="{l:Loc Backups_KeepLast}" VerticalAlignment="Center" />
                            </DockPanel>
                            <DockPanel Margin="0,0,0,6">
                                <TextBox DockPanel.Dock="Right" Width="70" Text="{Binding BackupKeepDaily, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="{l:Loc Backups_KeepDaily}" />
                                <TextBlock Text="{l:Loc Backups_KeepDaily}" VerticalAlignment="Center" />
                            </DockPanel>
                            <DockPanel Margin="0,0,0,12">
                                <TextBox DockPanel.Dock="Right" Width="70" Text="{Binding BackupKeepWeekly, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="{l:Loc Backups_KeepWeekly}" />
                                <TextBlock Text="{l:Loc Backups_KeepWeekly}" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock Text="{l:Loc Backups_Mirror}" FontWeight="SemiBold" />
                            <TextBlock Text="{l:Loc Backups_MirrorHint}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,6" />
                            <TextBlock Text="{Binding BackupMirrorDir}" FontFamily="{StaticResource MonoFont}" FontSize="12" TextWrapping="Wrap" Visibility="{Binding BackupMirrorDir, Converter={StaticResource NullVis}}" Margin="0,0,0,6" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="{l:Loc Backups_ChooseMirror}" Command="{Binding ChooseMirrorCommand}" />
                                <Button Content="{l:Loc Backups_ClearMirror}" Style="{StaticResource GhostButton}" Command="{Binding ClearMirrorCommand}" Margin="6,0,0,0" Visibility="{Binding BackupMirrorDir, Converter={StaticResource NullVis}}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Identity: icon + MOTD -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Visibility="{Binding Tab, Converter={StaticResource IndexVis}, ConverterParameter=7}" AutomationProperties.AutomationId="IdentityPage">
            <StackPanel>
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{l:Loc Identity_Icon}" Style="{StaticResource H2}" FontSize="15" />
                        <TextBlock Text="{l:Loc Identity_IconHint}" Style="{StaticResource Muted}" Margin="0,4,0,12" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal">
                            <Border Width="96" Height="96" CornerRadius="8" Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" ClipToBounds="True">
                                <Grid>
                                    <TextBlock Text="64×64" Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasIcon, Converter={x:Static l:Inverse.Visibility}}" />
                                    <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                </Grid>
                            </Border>
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <Button Content="{l:Loc Identity_ChooseImage}" Style="{StaticResource PrimaryButton}" Command="{Binding ChooseIconCommand}" HorizontalAlignment="Left" AutomationProperties.AutomationId="ChooseIcon" />
                                <Button Content="{l:Loc Identity_RemoveIcon}" Style="{StaticResource GhostButton}" Command="{Binding RemoveIconCommand}" HorizontalAlignment="Left" Margin="0,6,0,0" Visibility="{Binding HasIcon, Converter={StaticResource BoolVis}}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{l:Loc Identity_Motd}" Style="{StaticResource H2}" FontSize="15" />
                        <TextBlock Text="{l:Loc Identity_MotdHint}" Style="{StaticResource Muted}" Margin="0,4,0,12" TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding MotdColors}" Margin="0,0,0,8">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="22" Height="22" Margin="0,0,4,4" Padding="0" Background="{Binding Hex}" BorderBrush="{DynamicResource LineBrush}" ToolTip="{Binding Code}" Cursor="Hand"
                                            Command="{Binding DataContext.InsertMotdCodeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Code}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button"><Border CornerRadius="4" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" /></ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="B" FontWeight="Bold" Padding="10,4" Margin="0,0,4,0" Command="{Binding InsertMotdCodeCommand}" CommandParameter="l" ToolTip="{l:Loc Identity_Bold}" />
                            <Button Content="I" FontStyle="Italic" Padding="10,4" Margin="0,0,4,0" Command="{Binding InsertMotdCodeCommand}" CommandParameter="o" ToolTip="{l:Loc Identity_Italic}" />
                            <Button Padding="10,4" Margin="0,0,4,0" Command="{Binding InsertMotdCodeCommand}" CommandParameter="n" ToolTip="{l:Loc Identity_Underline}"><TextBlock Text="U" TextDecorations="Underline" /></Button>
                            <Button Padding="10,4" Margin="0,0,4,0" Command="{Binding InsertMotdCodeCommand}" CommandParameter="m" ToolTip="{l:Loc Identity_Strike}"><TextBlock Text="S" TextDecorations="Strikethrough" /></Button>
                            <Button Content="{l:Loc Identity_ResetStyle}" Padding="10,4" Command="{Binding InsertMotdCodeCommand}" CommandParameter="r" />
                        </StackPanel>
                        <TextBox Text="{Binding MotdText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="56" FontFamily="Consolas" TextWrapping="Wrap" AutomationProperties.AutomationId="MotdText" />
                        <TextBlock Margin="0,4,0,0" FontSize="12">
                            <Run Text="{Binding MotdLength, Mode=OneWay}" /><Run Text=" / 118" />
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MotdTooLong}" Value="True"><Setter Property="Foreground" Value="{DynamicResource FailBrush}" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{l:Loc Identity_Preview}" Style="{StaticResource Muted}" Margin="0,12,0,6" />
                        <Border Background="#FF2B2B2B" CornerRadius="6" Padding="10">
                            <DockPanel>
                                <Border Width="64" Height="64" Margin="0,0,10,0" Background="#FF3C3C3C" DockPanel.Dock="Left">
                                    <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" Foreground="White" FontFamily="Consolas" FontSize="14" />
                                    <ItemsControl ItemsSource="{Binding MotdLines}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <ItemsControl ItemsSource="{Binding}">
                                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock x:Name="T" Text="{Binding Text}" Foreground="{Binding Color}" FontFamily="Consolas" FontSize="14" />
                                                            <DataTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding Bold}" Value="True"><Setter TargetName="T" Property="FontWeight" Value="Bold" /></DataTrigger>
                                                                <DataTrigger Binding="{Binding Italic}" Value="True"><Setter TargetName="T" Property="FontStyle" Value="Italic" /></DataTrigger>
                                                                <DataTrigger Binding="{Binding Underline}" Value="True"><Setter TargetName="T" Property="TextDecorations" Value="Underline" /></DataTrigger>
                                                                <DataTrigger Binding="{Binding Strike}" Value="True"><Setter TargetName="T" Property="TextDecorations" Value="Strikethrough" /></DataTrigger>
                                                            </DataTemplate.Triggers>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                            <Button Content="{l:Loc Identity_Undo}" Command="{Binding ResetMotdCommand}" Margin="0,0,6,0" />
                            <Button Content="{l:Loc Identity_SaveMotd}" Style="{StaticResource PrimaryButton}" Command="{Binding SaveMotdCommand}" AutomationProperties.AutomationId="SaveMotd" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

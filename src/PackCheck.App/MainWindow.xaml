<Window x:Class="PackCheck.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:PackCheck.App.Infrastructure"
        xmlns:vm="clr-namespace:PackCheck.App.ViewModels"
        xmlns:v="clr-namespace:PackCheck.App.Views"
        Title="PackCheck" Width="1280" Height="800" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen" Icon="/Assets/app.ico"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="{StaticResource UiFont}" AutomationProperties.AutomationId="MainWindow">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:ServersViewModel}"><v:ServersView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ValidateViewModel}"><v:ValidateView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:PluginsViewModel}"><v:PluginsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ModsViewModel}"><v:PluginsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:OnlineViewModel}"><v:OnlineView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProxyViewModel}"><v:ProxyView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AssistantViewModel}"><v:AssistantView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><v:SettingsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AboutViewModel}"><v:AboutView /></DataTemplate>
        <BooleanToVisibilityConverter x:Key="BoolVis" />
        <l:NullToVisibility x:Key="NullVis" />
        <l:IndexToBool x:Key="IndexBool" />
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <!-- Sidebar -->
        <Border Grid.RowSpan="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,14,14,16">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,2,0,26">
                    <Image Source="/Assets/cube-256.png" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="PackCheck" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="19" />
                        <TextBlock Text="{l:Loc Tagline}" Style="{StaticResource Muted}" FontSize="11" />
                    </StackPanel>
                </StackPanel>

                <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Padding="12" Visibility="{Binding HasPendingRelease, Converter={StaticResource BoolVis}}"
                        Background="{DynamicResource PrimarySoftBrush}" BorderBrush="{DynamicResource PrimaryBrush}" AutomationProperties.AutomationId="UpdateBanner">
                    <StackPanel>
                        <TextBlock Text="{l:Loc Update_Available}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding PendingRelease.Tag}" Style="{StaticResource Muted}" Margin="0,2,0,8" />
                        <Button Content="{l:Loc Update_Now}" Style="{StaticResource PrimaryButton}" Command="{Binding ShowUpdateCommand}" Padding="10,6" />
                    </StackPanel>
                </Border>

                <StackPanel>
                    <RadioButton Style="{StaticResource NavButton}" GroupName="nav" AutomationProperties.AutomationId="NavServers"
                                 IsChecked="{Binding NavIndex, Converter={StaticResource IndexBool}, ConverterParameter=0}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconServers}" Style="{StaticResource IconPath}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            <TextBlock Text="{l:Loc Nav_Servers}" Margin="12,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButton}" GroupName="nav" AutomationProperties.AutomationId="NavValidate"
                                 IsChecked="{Binding NavIndex, Converter={StaticResource IndexBool}, ConverterParameter=1}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconValidate}" Style="{StaticResource IconPath}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            <TextBlock Text="{l:Loc Nav_Validate}" Margin="12,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                        </StackPanel>
                    </RadioButton>
                    <Grid>
                        <RadioButton IsEnabled="{Binding PluginsEnabled}" AutomationProperties.HelpText="{Binding PluginsDisabledReason}" Style="{StaticResource NavButton}" GroupName="nav" AutomationProperties.AutomationId="NavPlugins"
                                 IsChecked="{Binding NavIndex, Converter={StaticResource IndexBool}, ConverterParameter=2}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconPlugins}" Style="{StaticResource IconPath}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            <TextBlock Text="{l:Loc Nav_Plugins}" Margin="12,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                        </StackPanel>
                    </RadioButton>
                        <Border HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Width="22" Height="22" CornerRadius="11" Background="Transparent" Cursor="Help"
                                ToolTip="{Binding PluginsDisabledReason}" ToolTipService.InitialShowDelay="100" AutomationProperties.Name="{Binding PluginsDisabledReason}"
                                Visibility="{Binding PluginsEnabled, Converter={x:Static l:Inverse.Visibility}}">
                            <Path Data="{StaticResource IconClose}" Style="{StaticResource IconPath}" Width="9" Height="9" Stroke="{DynamicResource FailBrush}" />
                        </Border>
                    </Grid>
                    <Grid>
                        <RadioButton IsEnabled="{Binding ModsEnabled}" AutomationProperties.HelpText="{Binding ModsDisabledReason}" Style="{StaticResource NavButton}" GroupName="nav" AutomationProperties.AutomationId="NavMods"
                                 IsChecked="{Binding NavIndex, Converter={StaticResource IndexBool}, ConverterParameter=5}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconMods}" Style="{StaticResource IconPath}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            <TextBlock Text="{l:Loc Nav_Mods}" Margin="12,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                        </StackPanel>
                    </RadioButton>
                        <Border HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Width="22" Height="22" CornerRadius="11" Background="Transparent" Cursor="Help"
                                ToolTip="{Binding ModsDisabledReason}" ToolTipService.InitialShowDelay="100" AutomationProperties.Name="{Binding ModsDisabledReason}"
                                Visibility="{Binding ModsEnabled, Converter={x:Static l:Inverse.Visibility}}">
                            <Path Data="{StaticResource IconClose}" Style="{StaticResource IconPath}" Width="9" Height="9" Stroke="{DynamicResource FailBrush}" />
                        </Border>
                    </Grid>
                    <RadioButton Style="{StaticResource NavButton}" GroupName="nav" AutomationProperties.AutomationId="NavProxy"
                                 IsChecked="{Binding NavIndex, Converter={StaticResource IndexBool}, ConverterParameter=7}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconProxy}" Style="{StaticResource IconPath}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            <TextBlock Text="{l:Loc Nav_Proxy}" Margin="12,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButton}" GroupName="nav" AutomationProperties.AutomationId="NavOnline"
                                 IsChecked="{Binding NavIndex, Converter={StaticResource IndexBool}, ConverterParameter=6}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconOnline}" Style="{StaticResource IconPath}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            <TextBlock Text="{l:Loc Nav_Online}" Margin="12,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButton}" GroupName="nav" AutomationProperties.AutomationId="NavAssistant"
                                 IsChecked="{Binding NavIndex, Converter={StaticResource IndexBool}, ConverterParameter=8}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconAssistant}" Style="{StaticResource IconPath}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            <TextBlock Text="{l:Loc Nav_Assistant}" Margin="12,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButton}" GroupName="nav" AutomationProperties.AutomationId="NavSettings"
                                 IsChecked="{Binding NavIndex, Converter={StaticResource IndexBool}, ConverterParameter=3}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconSettings}" Style="{StaticResource IconPath}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            <TextBlock Text="{l:Loc Nav_Settings}" Margin="12,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButton}" GroupName="nav" AutomationProperties.AutomationId="NavAbout"
                                 IsChecked="{Binding NavIndex, Converter={StaticResource IndexBool}, ConverterParameter=4}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconAbout}" Style="{StaticResource IconPath}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            <TextBlock Text="{l:Loc Nav_About}" Margin="12,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Title bar buttons -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
            <Button Style="{StaticResource ChromeButton}" Click="OnMinimize" AutomationProperties.Name="Minimize">
                <Path Data="{StaticResource IconMin}" Style="{StaticResource IconPath}" Width="11" Height="11" Stroke="{DynamicResource TextMutedBrush}" />
            </Button>
            <Button Style="{StaticResource ChromeButton}" Click="OnMaximize" AutomationProperties.Name="Maximize">
                <Path Data="{StaticResource IconMax}" Style="{StaticResource IconPath}" Width="10" Height="10" Stroke="{DynamicResource TextMutedBrush}" />
            </Button>
            <Button Style="{StaticResource ChromeButton}" Click="OnClose" AutomationProperties.Name="Close">
                <Path Data="{StaticResource IconClose}" Style="{StaticResource IconPath}" Width="11" Height="11" Stroke="{DynamicResource TextMutedBrush}" />
            </Button>
        </StackPanel>

        <!-- Page host with slide + fade transition -->
        <ContentControl x:Name="PageHost" Grid.Row="1" Grid.Column="1" Content="{Binding CurrentPage}" Margin="32,4,32,24" Focusable="False">
            <ContentControl.RenderTransform><TranslateTransform x:Name="PageShift" /></ContentControl.RenderTransform>
        </ContentControl>

        <!-- Toast -->
        <Border Grid.Row="1" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,28" Padding="18,11" CornerRadius="9"
                Background="{DynamicResource Surface3Brush}" BorderThickness="1" Visibility="{Binding ToastText, Converter={StaticResource NullVis}}"
                AutomationProperties.AutomationId="Toast">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ToastIsError}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource FailBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding ToastText}" MaxWidth="560" TextWrapping="Wrap" />
        </Border>

        <!-- Update dialog -->
        <Grid Grid.RowSpan="2" Grid.ColumnSpan="2" Background="{DynamicResource OverlayBrush}" Visibility="{Binding IsUpdateDialogOpen, Converter={StaticResource BoolVis}}"
              AutomationProperties.AutomationId="UpdateDialog">
            <Border Style="{StaticResource Card}" Width="520" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="26" l:Anim.PopIn="True">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Assets/cube-256.png" Width="40" Height="40" />
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{l:Loc Update_Available}" Style="{StaticResource H2}" />
                            <TextBlock Style="{StaticResource Muted}">
                                <Run Text="{Binding PendingRelease.Title, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="{l:Loc Update_Notes}" Style="{StaticResource Label}" Margin="0,18,0,6" />
                    <Border Background="{DynamicResource Surface2Brush}" CornerRadius="7" Padding="12" MaxHeight="180">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding PendingRelease.Notes}" TextWrapping="Wrap" Style="{StaticResource Muted}" />
                        </ScrollViewer>
                    </Border>
                    <TextBlock Text="{Binding UpdateDialogHint}" TextWrapping="Wrap" Margin="0,14,0,0" Foreground="{DynamicResource WarnBrush}" />
                    <ProgressBar Margin="0,14,0,4" Maximum="1" Value="{Binding UpdateProgress}" Visibility="{Binding IsInstallingUpdate, Converter={StaticResource BoolVis}}" />
                    <TextBlock Text="{Binding UpdateProgressText}" Style="{StaticResource Muted}" Visibility="{Binding IsInstallingUpdate, Converter={StaticResource BoolVis}}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button Content="GitHub" Style="{StaticResource GhostButton}" Command="{Binding OpenReleasePageCommand}" Margin="0,0,8,0" />
                        <Button Content="{l:Loc Update_Later}" Command="{Binding PostponeUpdateCommand}" Margin="0,0,8,0" IsEnabled="{Binding IsInstallingUpdate, Converter={x:Static l:Inverse.Bool}}" AutomationProperties.AutomationId="UpdateLater" />
                        <Button Content="{l:Loc Update_Now}" Style="{StaticResource PrimaryButton}" Command="{Binding InstallUpdateCommand}" AutomationProperties.AutomationId="UpdateNow" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Text prompt -->
        <Grid Grid.RowSpan="2" Grid.ColumnSpan="2" Background="{DynamicResource OverlayBrush}" Visibility="{Binding Prompt, Converter={StaticResource NullVis}}">
            <Border Style="{StaticResource Card}" Width="440" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24" l:Anim.PopIn="True">
                <StackPanel>
                    <TextBlock Text="{Binding Prompt.Title}" Style="{StaticResource H2}" />
                    <TextBox Text="{Binding Prompt.Text, UpdateSourceTrigger=PropertyChanged}" Margin="0,14,0,0" FontFamily="{StaticResource MonoFont}" AutomationProperties.AutomationId="PromptText" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                        <Button Content="{l:Loc Common_Cancel}" Command="{Binding PromptCancelCommand}" Margin="0,0,8,0" IsCancel="True" />
                        <Button Content="{l:Loc Common_Confirm}" Style="{StaticResource PrimaryButton}" Command="{Binding PromptOkCommand}" IsDefault="True" AutomationProperties.AutomationId="PromptOk" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Confirmation dialog -->
        <Grid Grid.RowSpan="2" Grid.ColumnSpan="2" Background="{DynamicResource OverlayBrush}" Visibility="{Binding Confirm, Converter={StaticResource NullVis}}">
            <Border Style="{StaticResource Card}" Width="480" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24" l:Anim.PopIn="True">
                <StackPanel>
                    <TextBlock Text="{Binding Confirm.Title}" Style="{StaticResource H2}" />
                    <TextBlock Text="{Binding Confirm.Body}" Style="{StaticResource Muted}" Margin="0,10,0,0" TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                        <Button Content="{l:Loc Common_Cancel}" Command="{Binding ConfirmNoCommand}" Margin="0,0,8,0" IsCancel="True" AutomationProperties.AutomationId="ConfirmNo" />
                        <Button Content="{Binding Confirm.ConfirmText}" Command="{Binding ConfirmYesCommand}" AutomationProperties.AutomationId="ConfirmYes">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                    <Style.Triggers>
                                        <!-- destructive actions are red -->
                                        <DataTrigger Binding="{Binding Confirm.Danger}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource FailBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource FailBrush}" />
                                            <Setter Property="Foreground" Value="White" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>

                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <FontFamily x:Key="UiFont">pack://application:,,,/PackCheck;component/Assets/Fonts/#Inter</FontFamily>
    <FontFamily x:Key="DisplayFont">pack://application:,,,/PackCheck;component/Assets/Fonts/#Exo 2</FontFamily>
    <!-- Press Start 2P (OFL): pixel font for page titles and the logo, Minecraft-style. -->
    <FontFamily x:Key="PixelFont">pack://application:,,,/PackCheck;component/Assets/Fonts/#Press Start 2P</FontFamily>
    <FontFamily x:Key="MonoFont">pack://application:,,,/PackCheck;component/Assets/Fonts/#JetBrains Mono</FontFamily>

    <CubicEase x:Key="EaseOut" EasingMode="EaseOut" />

